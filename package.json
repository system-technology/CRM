{
  "name": "viajapro",
  "version": "0.1.0",
  "private": true,
  "description": "CRM vertical para agencias de turismo con WhatsApp Cloud API nativo",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:hooks": "node .claude/hooks/lib/politica-rama.test.mjs && node .claude/hooks/lib/guard-secretos.test.mjs",
    "compuertas": "node scripts/compuertas.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,jsx,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,jsx,json,yml,yaml}\"",
    "db:generate": "pnpm --filter @viajapro/database generate",
    "db:migrate": "pnpm --filter @viajapro/database migrate:dev",
    "db:seed": "pnpm --filter @viajapro/database seed",
    "db:studio": "pnpm --filter @viajapro/database studio",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml down -v && pnpm infra:up",
    "prepare": "husky",
    "preflight": "node scripts/preflight.mjs",
    "db:setup": "pnpm db:migrate:deploy && pnpm --filter @viajapro/database run rol:crear",
    "db:migrate:deploy": "pnpm --filter @viajapro/database run migrate:deploy",
    "db:aislamiento": "pnpm --filter @viajapro/database run test:aislamiento"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^10",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^9",
    "globals": "^17.13.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "pnpm": "9.12.0",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
