# Dependencias
node_modules/
.pnpm-store/

# Builds
dist/
build/
.next/
out/
*.tsbuildinfo

# Entorno
# Un patron por extension deja fuera lo que no se nombro: el script de rotacion
# dejaba un .env.bak con las credenciales ANTERIORES en claro, sin ignorar, y un
# `git add -A` lo habria subido. Se ignora todo lo que empiece por .env salvo el
# ejemplo. R6.
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Cache de herramientas
.turbo/
.eslintcache
coverage/
.nyc_output/
playwright-report/
test-results/

# Editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
.idea/
*.swp

# Sistema operativo
.DS_Store
Thumbs.db

# Infraestructura
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Secretos y datos sensibles
*.pem
*.key
*.p12
secrets/

# Salidas del MCP de navegador (capturas y trazas de depuracion)
.playwright-mcp/
