# =============================================================================
# ViajaPro — plantilla de variables de entorno
# Copiar a .env y completar. NUNCA commitear el .env real.
# =============================================================================

# ----- Aplicacion -----------------------------------------------------------
NODE_ENV=development
APP_ENV=local                      # local | dev | staging | production
APP_NAME=viajapro
API_PORT=3333
WEB_PORT=3000
API_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# INTERRUPTORES DE LA WEB: datos simulados o API de verdad
# ---------------------------------------------------------------------------
# Las pantallas se construyeron contra datos simulados para no esperar al backend, y el
# cambio a la API real va detrás de estos interruptores. **Vienen apagados**, asi que una
# instalacion recien clonada ensena un producto completo que no habla con nada.
#
# Esto no estaba documentado en ningun sitio: habia que leer `apps/web/src/lib/crm-api.ts`
# para enterarse de que existian. Un interruptor que solo conoce quien lo escribio no es un
# interruptor, es una trampa.
#
# NEXT_PUBLIC_*: Next.js las expone al NAVEGADOR. Nunca poner aqui un secreto.
NEXT_PUBLIC_API_URL=http://localhost:3333

# El tenant mientras no exista autenticacion. Lo imprime `pnpm db:seed` al terminar.
# Sin el, la API responde 401 y la pantalla parece rota sin decir por que.
NEXT_PUBLIC_DEV_TENANT_ID=

# Pipeline, ficha del contacto y directorio contra la API real.
NEXT_PUBLIC_USE_REAL_CRM=false

# Bandeja contra la API real. Hoy no hay API de bandeja todavia: dejar en false hasta que
# el trabajador persista el primer mensaje.
NEXT_PUBLIC_USE_REAL_INBOX=false

# ----- Base de datos --------------------------------------------------------
# TRES cadenas, y confundirlas rompe cosas distintas. Ver ADR-0007.
#
#   DATABASE_URL      rol PROPIETARIO, conexion DIRECTA. Solo migraciones y DDL.
#   DIRECT_URL        la misma. Prisma la exige aparte cuando hay agrupador de conexiones.
#   DATABASE_APP_URL      rol viajapro_app, conexion AGRUPADA. La que usa la API.
#   DATABASE_ALTAS_URL    rol viajapro_altas. SOLO el caso de uso de Embedded Signup.
#   DATABASE_WEBHOOK_URL  rol viajapro_webhook. SOLO apps/worker.
#   DATABASE_IDENTIDAD_URL rol viajapro_identidad (ADR-0011). SOLO el pool de Better Auth: toca
#                         las tablas globales de identidad y NINGUNA de negocio.
#
# Los tres roles de aplicacion tienen privilegios IDENTICOS sobre las tablas de negocio y
# se diferencian unicamente en que funciones pueden ejecutar (ADR-0008 1.3). Apuntar
# DATABASE_APP_URL al rol de altas devuelve a toda la API la capacidad de repuntar un
# numero de WhatsApp hacia otro tenant, y ningun guardia que solo mire BYPASSRLS lo
# detectaria: por eso cada proceso afirma al arrancar que rol espera ser.
#
# La aplicacion NUNCA usa DATABASE_URL: ese rol puede saltarse Row Level Security, y el
# aislamiento entre agencias seria ficticio. Sin error y sin aviso, hasta que una agencia
# vea los datos de otra.

# --- Opcion 1: PostgreSQL gestionado en Neon (recomendada, sin instalar nada) ---
# 1. Crear proyecto en https://neon.tech
# 2. Copiar las cadenas del panel. La AGRUPADA lleva '-pooler' en el host; la DIRECTA no.
# 3. Aplicar migraciones (crean los cinco roles, sin contrasena) y luego poner contrasenas:
#      pnpm db:migrate:deploy
#      pnpm --filter @viajapro/database run rol:crear
#    El segundo comando imprime las TRES lineas de aplicacion, ya armadas, una sola vez.
#    (Ya no se invoca 002 con psql: desde ADR-0008 no fija contrasenas ni usa meta-ordenes
#     de psql, para que la asercion 22 pueda reaplicarlo entero desde la prueba.)
#
# DATABASE_URL=postgresql://OWNER:CLAVE@ep-xxxx.REGION.aws.neon.tech/viajapro?sslmode=require
# DIRECT_URL=postgresql://OWNER:CLAVE@ep-xxxx.REGION.aws.neon.tech/viajapro?sslmode=require
# DATABASE_APP_URL=postgresql://viajapro_app:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/viajapro?sslmode=require
# DATABASE_ALTAS_URL=postgresql://viajapro_altas:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/viajapro?sslmode=require
# DATABASE_WEBHOOK_URL=postgresql://viajapro_webhook:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/viajapro?sslmode=require
# DATABASE_IDENTIDAD_URL=postgresql://viajapro_identidad:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/viajapro?sslmode=require

# --- Opcion 2: PostgreSQL local con Docker ---
# Las tres cadenas de aplicacion las imprime, ya armadas:
#   pnpm infra:up && pnpm db:migrate && pnpm --filter @viajapro/database run roles:dev
# Ese script es la UNICA fuente de las contrasenas locales, y se niega a correr contra un
# servidor que no sea local salvo en CI.
DATABASE_URL=postgresql://viajapro:viajapro@localhost:5432/viajapro?schema=public
DIRECT_URL=postgresql://viajapro:viajapro@localhost:5432/viajapro?schema=public
DATABASE_APP_URL=postgresql://viajapro_app:desarrollo-local-sin-valor@localhost:5432/viajapro?schema=public
DATABASE_ALTAS_URL=postgresql://viajapro_altas:desarrollo-local-sin-valor@localhost:5432/viajapro?schema=public
DATABASE_WEBHOOK_URL=postgresql://viajapro_webhook:desarrollo-local-sin-valor@localhost:5432/viajapro?schema=public
# ADR-0011: pool de Better Auth. Solo las tablas globales de identidad; ninguna de negocio.
DATABASE_IDENTIDAD_URL=

DATABASE_POOL_MAX=20

# ----- Redis (cache, colas BullMQ, rate limit, pub/sub de realtime) ---------
REDIS_URL=redis://localhost:6379
# Cola de changes del inbox: sin Redis (desarrollo sin infra:up) se declara COLA_CHANGES=inerte y los
# changes quedan PENDIENTES sin trabajador. No es un respaldo: sin REDIS_URL ni esto, la API no arranca.
# COLA_CHANGES=inerte

# ----- Almacenamiento de objetos (media de WhatsApp, PDFs, documentos) ------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=viajapro-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ----- Autenticacion --------------------------------------------------------
# ADR-0011: Better Auth autoalojado, sesion opaca en cookie. Sin valores por omision.
#   BETTER_AUTH_SECRET     firma las cookies. 32+ caracteres: openssl rand -base64 48
#   IDENTIDAD_DEV_PASSWORD contrasena de las identidades de la semilla, SOLO en desarrollo:
#                          pnpm --filter @viajapro/api identidad:sembrar-dev
#   IDENTIDAD_DEV_PERMITIR_REMOTO=si  opt-in para sembrarla en una base REMOTA de desarrollo
#                          (p. ej. Neon con solo datos sinteticos). Se pasa en la linea de
#                          comandos de la orden y NO se guarda aqui ni en el .env. Se niega si
#                          existe una sola identidad que no sea @agenciademo.test.
BETTER_AUTH_SECRET=
IDENTIDAD_DEV_PASSWORD=
# Saltos de proxy de confianza para req.ip (limite de intentos): un numero o lista de IP/CIDR.
# Vacio = ninguno: x-forwarded-for se ignora. Con balanceador propio delante: 1.
API_TRUST_PROXY=
# (Las AUTH_JWT_* de abajo son del diseno anterior, con JWT. Ya nada las lee.)
AUTH_JWT_ACCESS_SECRET=cambiar-por-secreto-de-64-bytes
AUTH_JWT_REFRESH_SECRET=cambiar-por-otro-secreto-de-64-bytes
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Clave maestra para cifrado de credenciales de tenant en reposo (AES-256-GCM).
# Generar con: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# ----- WhatsApp Cloud API (Meta) -------------------------------------------
# App de Meta en modo "Tech Provider". Un solo App ID para todos los tenants;
# cada agencia aporta su propio WABA y numero via Embedded Signup.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=                    # Configuration ID del flujo de Embedded Signup
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com
# Token que Meta debe devolver al verificar la suscripcion del webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cambiar-por-cadena-aleatoria
# System User Token del Tech Provider (para onboarding y gestion de WABAs).
META_SYSTEM_USER_TOKEN=
# Numero de PRUEBA de Meta (docs/10-onboarding/03). Un solo nombre para todo el codigo:
# el script `canal:registrar-prueba` y el envio saliente (ADR-0018) leen ESTOS dos.
# Identificadores, no secretos; solo digitos.
META_PHONE_NUMBER_ID_PRUEBA=
META_WABA_ID_PRUEBA=
# UUID de la agencia (tenant) dueña del canal de prueba. El token de la plataforma SOLO se usa
# para enviar desde esa agencia: otra que registre el mismo phone_number_id no lo obtiene (T-060).
# Sin el, el envio saliente queda FALLIDO. `canal:registrar-prueba` imprime el valor a fijar.
META_TENANT_ID_PRUEBA=

# --- Los dos secretos de plataforma de ADR-0008 ----------------------------
# El esquema YA se comprometio con ellos: `enrutamiento_canales.pimienta_version` y
# `recepciones_webhook.clave_version` son columnas NOT NULL. Sin estos valores no se puede
# escribir una sola fila real, y por eso estan aqui antes que el codigo que los usa.
# Ambos son CLASES DE SECRETO PROPIAS, distintas de ENCRYPTION_MASTER_KEY: se registran
# con custodio y periodicidad en docs/05-seguridad/02-proteccion-de-datos.md §5 (tarea 4d).
#
# PIMIENTA DEL DIRECTORIO. La clave de ruteo se guarda como
# HMAC-SHA256(pimienta, 'pn:'||phone_number_id). Con la pimienta FUERA de la base, un
# volcado —replica, respaldo, consola del proveedor— no revela ni un solo identificador.
# Generar con: openssl rand -base64 32
WHATSAPP_DIRECTORY_PEPPER=
WHATSAPP_DIRECTORY_PEPPER_VERSION=1
# Ventana de dos pimientas: durante una rotacion el trabajador pregunta con la actual y,
# si no hay fila, con la anterior. **La rotacion termina cuando acaba la reconstruccion,
# no cuando se cambia el secreto.**
WHATSAPP_DIRECTORY_PEPPER_PREVIOUS=
# Mientras valga `true`, la rama "tenant desconocido" RETIENE en vez de borrar. Sin esto,
# rotar la pimienta destruye mensajes de clientes: un directorio a medio reconstruir no
# responde "espera", responde "desconocido", y ese caso borra el contenido en el acto.
WHATSAPP_DIRECTORY_REBUILD_IN_PROGRESS=false
#
# CLAVE DE PLATAFORMA DEL STAGING (AES-256-GCM). Cifra el cuerpo del webhook mientras no
# se sabe de que agencia es. **Vive solo en el proceso del trabajador, nunca en la API:**
# el proceso que puede listar no es el que puede descifrar. AAD = recepcion_id.
# Rotacion sin recifrado: las filas nuevas usan la version siguiente y la anterior se
# conserva solo para descifrar hasta que la purga vacie la ultima fila que la usa.
WEBHOOK_PAYLOAD_KEY=
WEBHOOK_PAYLOAD_KEY_VERSION=1
WEBHOOK_PAYLOAD_KEY_PREVIOUS=

# ----- Pagos de clientes finales (checkout de la agencia) -------------------
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- Facturacion del SaaS (suscripciones de las agencias) ----------------
BILLING_PROVIDER=stripe            # stripe | paddle
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=

# ----- Diseno: Google Stitch (MCP) ------------------------------------------
# NO va aqui. Stitch se registra a nivel de USUARIO, fuera del repositorio:
#   claude mcp add stitch --transport http https://stitch.googleapis.com/mcp
#        --header "X-Goog-Api-Key: TU_CLAVE" -s user
# Motivo: .mcp.json expande variables desde el entorno del proceso, no desde este
# archivo. Ver docs/09-ia/04-mcp.md

# ----- Inteligencia artificial ---------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-5
AI_MONTHLY_BUDGET_USD=500

# ----- Correo transaccional -------------------------------------------------
# Correo (ADR-0011, rebanada 4): SIEMPRE por cola y detras de un puerto.
#   MAIL_PROVIDER  mailpit (local, pnpm infra:up; bandeja en http://localhost:8025) | memoria (pruebas)
#                  | postmark (produccion, ADR-0012: exige POSTMARK_SERVER_TOKEN o la API y el
#                  trabajador abortan al arrancar; nunca hay respaldo a Mailpit).
#   COLA_CORREO    vacio = BullMQ (necesita REDIS_URL y el trabajador: pnpm --filter @viajapro/api worker)
#                  memoria = sin Redis ni trabajador, entrega al instante (pruebas y desarrollo suelto)
MAIL_PROVIDER=mailpit
COLA_CORREO=
# Bus de eventos entre el trabajador y la API (bandeja en vivo, Socket.IO):
#   BUS_DE_EVENTOS vacio = Redis pub/sub (REDIS_URL). memoria = un solo proceso, sin Redis (pruebas).
BUS_DE_EVENTOS=
# Limite de envios de codigo por correo (OTP): contadores en Redis con TTL, clave hasheada.
#   LIMITADOR_OTP vacio = Redis (REDIS_URL). memoria = pruebas.
#   OTP_ENVIOS_POR_CORREO (3), OTP_ENVIOS_POR_IP (10), OTP_VENTANA_SEGUNDOS (900).
#   SOCKET_REVALIDACION_MAX_FALLOS (3): fallos seguidos de revalidacion del socket antes de cerrarlo.
LIMITADOR_OTP=
SOCKET_REVALIDACION_MAX_FALLOS=3
#   CORREO_PAYLOAD_KEY  32 bytes (hex o base64) COMPARTIDOS entre la API y el trabajador: cifran el
#                  mensaje en Redis (lleva tokens y codigos). openssl rand -base64 32
CORREO_PAYLOAD_KEY=
MAIL_SMTP_HOST=localhost
MAIL_SMTP_PORT=1025
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
MAIL_FROM="ViajaPro <no-reply@viajapro.com>"

# ----- Observabilidad -------------------------------------------------------
LOG_LEVEL=debug                    # fatal|error|warn|info|debug|trace
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=viajapro-api

# ----- Limites y politicas --------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
WEBHOOK_MAX_BODY_BYTES=1048576
