# =============================================================================
# ViajaPro — plantilla de variables de entorno
# Copiar a .env y completar. NUNCA commitear el .env real.
# =============================================================================

# ----- Aplicacion -----------------------------------------------------------
NODE_ENV=development
APP_ENV=local                      # local | dev | staging | production
APP_NAME=viajapro
API_PORT=3333
WEB_PORT=3000
API_PUBLIC_URL=http://localhost:3333
WEB_PUBLIC_URL=http://localhost:3000

# ----- Base de datos --------------------------------------------------------
# TRES cadenas, y confundirlas rompe cosas distintas. Ver ADR-0007.
#
#   DATABASE_URL      rol PROPIETARIO, conexion DIRECTA. Solo migraciones y DDL.
#   DIRECT_URL        la misma. Prisma la exige aparte cuando hay agrupador de conexiones.
#   DATABASE_APP_URL  rol viajapro_app, conexion AGRUPADA. La que usa la aplicacion.
#
# La aplicacion NUNCA usa DATABASE_URL: ese rol puede saltarse Row Level Security, y el
# aislamiento entre agencias seria ficticio. Sin error y sin aviso, hasta que una agencia
# vea los datos de otra.

# --- Opcion 1: PostgreSQL gestionado en Neon (recomendada, sin instalar nada) ---
# 1. Crear proyecto en https://neon.tech
# 2. Copiar las cadenas del panel. La AGRUPADA lleva '-pooler' en el host; la DIRECTA no.
# 3. Crear el rol de aplicacion:
#      psql "$DATABASE_URL" -v app_password="$(openssl rand -base64 24)" \
#           -f packages/database/prisma/policies/002-rol-aplicacion.sql
#
# DATABASE_URL=postgresql://OWNER:CLAVE@ep-xxxx.REGION.aws.neon.tech/viajapro?sslmode=require
# DIRECT_URL=postgresql://OWNER:CLAVE@ep-xxxx.REGION.aws.neon.tech/viajapro?sslmode=require
# DATABASE_APP_URL=postgresql://viajapro_app:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/viajapro?sslmode=require

# --- Opcion 2: PostgreSQL local con Docker ---
DATABASE_URL=postgresql://viajapro:viajapro@localhost:5432/viajapro?schema=public
DIRECT_URL=postgresql://viajapro:viajapro@localhost:5432/viajapro?schema=public
DATABASE_APP_URL=postgresql://viajapro_app:viajapro_app@localhost:5432/viajapro?schema=public

DATABASE_POOL_MAX=20

# ----- Redis (cache, colas BullMQ, rate limit, pub/sub de realtime) ---------
REDIS_URL=redis://localhost:6379

# ----- Almacenamiento de objetos (media de WhatsApp, PDFs, documentos) ------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=viajapro-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ----- Autenticacion --------------------------------------------------------
AUTH_JWT_ACCESS_SECRET=cambiar-por-secreto-de-64-bytes
AUTH_JWT_REFRESH_SECRET=cambiar-por-otro-secreto-de-64-bytes
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=

# Clave maestra para cifrado de credenciales de tenant en reposo (AES-256-GCM).
# Generar con: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# ----- WhatsApp Cloud API (Meta) -------------------------------------------
# App de Meta en modo "Tech Provider". Un solo App ID para todos los tenants;
# cada agencia aporta su propio WABA y numero via Embedded Signup.
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=                    # Configuration ID del flujo de Embedded Signup
META_GRAPH_VERSION=v21.0
META_GRAPH_BASE_URL=https://graph.facebook.com
# Token que Meta debe devolver al verificar la suscripcion del webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=cambiar-por-cadena-aleatoria
# System User Token del Tech Provider (para onboarding y gestion de WABAs).
META_SYSTEM_USER_TOKEN=

# ----- Pagos de clientes finales (checkout de la agencia) -------------------
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
WOMPI_INTEGRITY_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ----- Facturacion del SaaS (suscripciones de las agencias) ----------------
BILLING_PROVIDER=stripe            # stripe | paddle
BILLING_STRIPE_SECRET_KEY=
BILLING_STRIPE_WEBHOOK_SECRET=

# ----- Diseno: Google Stitch (MCP) ------------------------------------------
# NO va aqui. Stitch se registra a nivel de USUARIO, fuera del repositorio:
#   claude mcp add stitch --transport http https://stitch.googleapis.com/mcp
#        --header "X-Goog-Api-Key: TU_CLAVE" -s user
# Motivo: .mcp.json expande variables desde el entorno del proceso, no desde este
# archivo. Ver docs/09-ia/04-mcp.md

# ----- Inteligencia artificial ---------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-5
AI_MONTHLY_BUDGET_USD=500

# ----- Correo transaccional -------------------------------------------------
MAIL_PROVIDER=resend               # resend | ses | smtp
RESEND_API_KEY=
MAIL_FROM="ViajaPro <no-reply@viajapro.com>"

# ----- Observabilidad -------------------------------------------------------
LOG_LEVEL=debug                    # fatal|error|warn|info|debug|trace
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=viajapro-api

# ----- Limites y politicas --------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
WEBHOOK_MAX_BODY_BYTES=1048576
