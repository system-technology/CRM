{
  "name": "@viajapro/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "test:aislamiento": "dotenv -e ../../.env -- vitest run tests/aislamiento.spec.ts",
    "lint": "eslint prisma tests",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "rol:crear": "dotenv -e ../../.env -- node scripts/crear-rol-aplicacion.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "pg": "^8.13.1",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "dotenv-cli": "^7.4.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
