// =============================================================================
// ViajaPro — esquema de datos
//
// Reglas que este archivo hace cumplir (ver CLAUDE.md):
//   R1  Toda tabla de negocio lleva tenantId y política RLS con USING y WITH CHECK.
//   R8  Dinero en enteros (unidad mínima de la moneda) + código ISO-4217. Nunca Float.
//   R9  Instantes en UTC (timestamptz). Las fechas de viaje son `date`, sin hora.
//   R12 Lo que cada agencia define distinto es TABLA por tenant, nunca enum en el código.
//
// Las políticas RLS NO viven aquí: Prisma no las modela. Están en prisma/policies/ y se
// aplican por migración. La prueba de aislamiento (tests/aislamiento.spec.ts) falla si una
// tabla de negocio nueva aparece sin su política.
//
// Alcance: cabeza de playa — la agencia que revende paquetes.
// Ver docs/01-producto/07-cabeza-de-playa-paquetes.md
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  // Conexión de las MIGRACIONES y el DDL, con el rol propietario.
  // Con un PostgreSQL gestionado que tiene agrupador de conexiones (Neon), debe apuntar al
  // endpoint DIRECTO: las migraciones no funcionan contra el agrupado.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ADVERTENCIA
//
// La cadena de arriba es la del rol PROPIETARIO y solo la usan las migraciones.
// La aplicación en ejecución se conecta SIEMPRE con DATABASE_APP_URL, que apunta al rol
// `viajapro_app`: sin BYPASSRLS y sin pertenecer a neon_superuser.
//
// Si la aplicación usara esta cadena se saltaría todas las políticas RLS, y el aislamiento
// entre agencias sería ficticio: sin error, sin aviso, hasta que una agencia vea los datos
// de otra. Ver ADR-0003 y ADR-0007.

// =============================================================================
// PLATAFORMA — tablas globales, SIN tenantId y SIN RLS.
//
// Son las únicas excepciones permitidas a R1, y cada una está justificada aquí.
// Una tabla sin tenantId que no esté en esta sección es un defecto bloqueante.
// =============================================================================

/// La agencia cliente. Es la unidad de aislamiento: define qué es "un tenant".
/// Global por necesidad — es la tabla que da sentido a todas las demás.
model Tenant {
  id     String @id @default(uuid(7)) @db.Uuid
  /// Identificador legible para URLs y soporte: "viajes-del-caribe"
  slug   String @unique @db.VarChar(63)
  nombre String @db.VarChar(200)

  /// Mercado de operación. Decide moneda, impuestos y normativa por defecto.
  paisIso     String @default("CO") @map("pais_iso") @db.Char(2)
  monedaIso   String @default("COP") @map("moneda_iso") @db.Char(3)
  zonaHoraria String @default("America/Bogota") @map("zona_horaria") @db.VarChar(64)

  estado EstadoTenant @default(EN_PRUEBA)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuarios          Usuario[]
  etapas            EtapaPipeline[]
  mayoristas        Mayorista[]
  paquetes          Paquete[]
  contactos         Contacto[]
  oportunidades     Oportunidad[]
  definicionesCampo DefinicionCampoPersonalizado[]
  cuentasWhatsapp   CuentaWhatsapp[]
  canales           Canal[]
  notasInternas     NotaInterna[]
  consentimientos   ConsentimientoContacto[]
  seguimientos      Seguimiento[]

  conversaciones Conversacion[]
  mensajes       Mensaje[]
  adjuntos       Adjunto[]
  plantillas     PlantillaWhatsapp[]

  cotizaciones        Cotizacion[]
  versionesCotizacion VersionCotizacion[]

  roles            Rol[]
  formatosDeViaje  FormatoDeViaje[]
  opcionesDeSalida OpcionDeSalida[]
  /// Índice global de pertenencias (ADR-0011). Lo escribe solo el disparador de `usuarios`.
  accesosIdentidad AccesoIdentidad[]
  sesionesActivas  Sesion[]

  @@map("tenants")
}

enum EstadoTenant {
  EN_PRUEBA
  ACTIVO
  SUSPENDIDO
  CANCELADO

  @@map("estado_tenant")
}

/// Monedas habilitadas. Dato de referencia universal, igual para todos.
model Moneda {
  codigoIso String @id @map("codigo_iso") @db.Char(3)
  nombre    String @db.VarChar(80)
  /// Cuántos decimales tiene la moneda. COP = 0, USD = 2.
  /// Es lo que convierte `unidades` en un importe legible. Ver packages/domain/money.ts.
  decimales Int    @db.SmallInt

  @@map("monedas")
}

// -----------------------------------------------------------------------------
// Las cuatro tablas globales de ADR-0008. NINGUNA lleva `tenant_id`, y eso NO es
// cosmético: si alguna columna se llamara así, el aplicador dirigido por datos de
// `policies/001-aislamiento-tenant.sql` le pondría RLS automáticamente y volvería a
// ser ilegible sin contexto de tenant — que es justo el ciclo huevo-gallina que el
// ADR existe para romper, y se descubriría en producción sin ningún error. Por eso
// la columna del directorio se llama `tenant_resuelto_id`. Lo verifica la aserción 17.
//
// Ningún rol de login tiene un solo privilegio sobre ellas: se llegan por función
// `SECURITY DEFINER`. Están modeladas aquí para que Prisma no las vea como deriva y
// proponga borrarlas, no para que nadie las consulte desde el cliente: cualquier uso
// accidental desde la API falla con 42501, que es el fallo ruidoso que se quiere.
// -----------------------------------------------------------------------------

/// Declaración de qué tablas están fuera de RLS y con qué privilegios, por par
/// (tabla, rol). Es **dato de control**, no un catálogo inocuo: `001` y `002` aplican
/// literalmente lo que diga esta tabla, así que quien pudiera escribirla conseguiría
/// que el siguiente despliegue le concediera privilegios por sí solo. De ahí que se
/// declare a sí misma con privilegios vacíos y que la aserción 11 fije sus tripletas
/// contra un literal que vive en el repositorio. Ver ADR-0008 §1.2.
model ExcepcionRls {
  tabla       String   @db.Text
  rol         String   @db.Text
  /// Privilegios exactos que ese rol debe tener sobre esa tabla. `{}` = ninguno.
  privilegios String[] @db.Text
  motivo      String   @db.Text

  @@id([tabla, rol])
  @@map("excepciones_rls")
}

/// Directorio de enrutamiento: el mapa `identificador de Meta` → tenant.
///
/// La clave va en **HMAC-SHA256 con pimienta fuera de la base**, nunca en claro:
/// `phone_number_id` es numérico y de espacio pequeño, así que un hash simple se
/// invierte por fuerza bruta en minutos. Con la pimienta en el almacén de secretos,
/// un volcado de la base, de una réplica o de un respaldo no revela ni un solo
/// identificador. El tipo entra DENTRO del HMAC (`pn:` o `waba:`), lo que separa
/// dominios sin columna de tipo. Ver ADR-0008 §1.1.
model EnrutamientoCanal {
  claveCanalHmac   Bytes   @id @map("clave_canal_hmac")
  tenantResueltoId String  @map("tenant_resuelto_id") @db.Uuid
  /// Nulo en las filas de tipo WABA: un evento de gestión apunta a la cuenta, no a un número.
  canalId          String? @map("canal_id") @db.Uuid
  /// Al revés: relleno solo en las filas de tipo WABA. Una restricción `CHECK` exige que
  /// exactamente una de las dos esté presente, y así **ninguna fila queda sin respaldo del
  /// motor**. La primera versión solo tenía `canal_id`, y las filas WABA —las que gobiernan
  /// todos los eventos de gestión— entraban sin que nada comprobara de quién era la cuenta.
  cuentaId         String? @map("cuenta_id") @db.Uuid

  /// Clave foránea **compuesta**: `(canal_id, tenant_resuelto_id)` contra
  /// `canales (id, tenant_id)`. Escrita simple apuntaría al canal de otro tenant sin
  /// que nada lo impidiera, y nadie lo notaría hasta que una fila cruzara agencias.
  /// Es el patrón de toda referencia cruzada entre tablas con tenant. Aserción 25.
  canal Canal? @relation(fields: [canalId, tenantResueltoId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  /// La misma protección para las filas WABA. Aserción 25bis.
  cuenta CuentaWhatsapp? @relation(fields: [cuentaId, tenantResueltoId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  estado          EstadoEnrutamiento
  /// Con qué pimienta se calculó la clave. Es lo que permite saber, durante una
  /// rotación, qué filas están reconstruidas y cuáles no.
  pimientaVersion Int                @map("pimienta_version") @db.SmallInt

  @@index([tenantResueltoId])
  @@index([cuentaId])
  @@map("enrutamiento_canales")
}

/// Historial del directorio: que un secuestro sea detectable y demostrable.
///
/// `registros_auditoria` no sirve para esto: tiene `tenant_id` y RLS forzada, así que
/// el registro del ataque quedaría archivado bajo el **atacante** y la víctima no
/// podría verlo jamás. Solo inserción: ningún rol tiene `UPDATE` ni `DELETE`, ni
/// siquiera el propietario (aserción 24). Su retención de 5 años se ejecuta soltando
/// particiones anuales — soltar una partición no es un `DELETE` sobre filas, así que
/// el plazo es aplicable sin conceder a nadie el privilegio que lo invalidaría todo.
///
/// Se indexa por `canal_id` y `cuenta_id`, **nunca por el HMAC**: el HMAC depende de un
/// secreto rotable, y tras la primera rotación la historia quedaría inconsultable para
/// siempre. Hacen falta los dos porque `canal_id` es nulo en las filas WABA.
model EnrutamientoHistorial {
  /// `gen_random_uuid()` y no uuid v7: lo genera el motor dentro de una función, y
  /// PostgreSQL 16 —la versión del entorno local— no trae `uuidv7()`. El orden temporal
  /// lo da `ocurrido_en`, que además es la clave de particionado.
  id              String  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canalId         String? @map("canal_id") @db.Uuid
  cuentaId        String? @map("cuenta_id") @db.Uuid
  /// Atributos informativos, no clave de búsqueda.
  claveCanalHmac  Bytes   @map("clave_canal_hmac")
  pimientaVersion Int     @map("pimienta_version") @db.SmallInt

  tenantAnterior String?             @map("tenant_anterior") @db.Uuid
  tenantNuevo    String              @map("tenant_nuevo") @db.Uuid
  estadoAnterior EstadoEnrutamiento? @map("estado_anterior")
  estadoNuevo    EstadoEnrutamiento  @map("estado_nuevo")

  actorUsuarioId String?  @map("actor_usuario_id") @db.Uuid
  actorTenantId  String?  @map("actor_tenant_id") @db.Uuid
  motivo         String   @db.VarChar(200)
  /// `clock_timestamp()` y no `now()`: `CURRENT_TIMESTAMP` es constante durante toda la
  /// transacción, así que los dos asientos de un mismo alta —la fila WABA y la del
  /// número— empataban y «el último» era arbitrario.
  ocurridoEn     DateTime @default(dbgenerated("clock_timestamp()")) @map("ocurrido_en") @db.Timestamptz(3)

  /// La clave primaria incluye la columna de particionado porque PostgreSQL lo exige.
  @@id([id, ocurridoEn])
  @@index([canalId, ocurridoEn(sort: Desc)])
  @@index([cuentaId, ocurridoEn(sort: Desc)])
  @@index([tenantNuevo, ocurridoEn(sort: Desc)])
  @@map("enrutamiento_historial")
}

/// Staging del webhook: el evento aterriza aquí **antes** del 200 a Meta.
///
/// El invariante: no se devuelve 200 antes de que el evento esté en una tabla durable.
/// Encolar a secas no lo cumple — Redis no es un almacén transaccional y una pérdida
/// ahí es un mensaje de cliente que ningún asesor verá jamás.
///
/// Es la única tabla con contenido de varios tenants sin RLS, así que el contenido va
/// cifrado desde el proceso de Node (nunca con `pgcrypto`, que dejaría la clave en
/// `pg_stat_statements`), con nonce y etiqueta por fila, AAD = `recepcion_id` y versión
/// de clave para poder rotar sin recifrar. Vive **minutos**: se anula al clasificar.
model RecepcionWebhook {
  /// `sha256` del cuerpo crudo del POST. Irreversible: no es dato personal.
  recepcionId    Bytes  @id @map("recepcion_id")
  payloadCifrado Bytes? @map("payload_cifrado")
  /// 96 bits aleatorios por fila.
  payloadNonce   Bytes? @map("payload_nonce")
  payloadTag     Bytes? @map("payload_tag")
  claveVersion   Int    @map("clave_version") @db.SmallInt

  recibidoEn DateTime  @default(now()) @map("recibido_en") @db.Timestamptz(3)
  anuladoEn  DateTime? @map("anulado_en") @db.Timestamptz(3)

  changes RecepcionWebhookChange[]

  @@index([recibidoEn])
  @@map("recepciones_webhook")
}

/// El grano real del procesamiento es el `change`, no el POST.
///
/// Un POST puede traer varios `changes` de WABAs distintos. Con el estado de proceso en
/// la fila de la recepción, procesar el primero marcaba la recepción entera y anulaba el
/// payload: los mensajes de los otros dos tenants no existieron nunca, sin un solo error.
/// Por eso `procesado_en` vive aquí. Ver ADR-0008 §4 y RV-1 de la auditoría.
model RecepcionWebhookChange {
  recepcionId Bytes            @map("recepcion_id")
  recepcion   RecepcionWebhook @relation(fields: [recepcionId], references: [recepcionId], onDelete: Cascade)
  /// Orden aplanado sobre `entry[].changes[]`. Definido de una vez: dos convenciones
  /// distintas producirían identificadores de trabajo distintos para el mismo reintento.
  indice      Int              @db.SmallInt

  estado          EstadoChangeRecepcion @default(PENDIENTE)
  procesadoEn     DateTime?             @map("procesado_en") @db.Timestamptz(3)
  /// Cuántas veces lo reencoló el barrido. Lo suma `contar_reencolado_barrido`; el listado
  /// excluye a los que pasan del tope para que los abandonados no tapen a los nuevos.
  intentosBarrido Int                   @default(0) @map("intentos_barrido") @db.SmallInt

  @@id([recepcionId, indice])
  @@index([procesadoEn])
  @@map("recepciones_webhook_changes")
}

/// Deliberadamente **gemelo** de `EstadoCanal`, y nada en el motor los ata.
///
/// Son dos conceptos distintos que hoy coinciden: uno es el estado del canal bajo RLS
/// —la verdad— y el otro el del directorio global, que es su proyección derivada. Nada
/// garantiza que no diverjan: si el camino de baja marca `canales.estado = 'REVOCADO'` y
/// no llama a `registrar_enrutamiento`, el directorio sigue resolviendo `ACTIVO` y los
/// mensajes de una agencia **sin contrato** se siguen persistiendo. Sin contrato no hay
/// finalidad (Ley 1581), y nada lo pone en rojo desde la base.
///
/// Mantenerlos sincronizados es responsabilidad del camino de baja, **en la misma
/// transacción**, y le toca a la tarea 4b con su métrica de reconciliación.
enum EstadoEnrutamiento {
  ACTIVO
  SUSPENDIDO
  REVOCADO

  @@map("estado_enrutamiento")
}

enum EstadoChangeRecepcion {
  PENDIENTE
  /// Procesado con éxito bajo su tenant.
  PROCESADO
  /// Clasificado sin procesar: tenant desconocido o revocado. El contenido se borró.
  CLASIFICADO

  @@map("estado_change_recepcion")
}

// =============================================================================
// IDENTIDAD — ADR-0011
//
// La identidad es GLOBAL y la pertenencia NO. Una persona (`Identidad`) existe antes de
// elegir agencia, así que sus cinco tablas no llevan tenant y están declaradas en
// `excepciones_rls`: solo el rol `viajapro_identidad` (el pool de Better Auth) las toca, y
// ese rol no tiene ningún privilegio sobre las tablas de negocio. La pertenencia a una
// agencia (`Usuario`) y los roles (`Rol`) llevan `tenant_id` y RLS forzada.
//
// **Ninguna de las cinco tiene una columna llamada `tenant_id`**, y es a propósito: el
// aplicador de `policies/001` les pondría RLS y el inicio de sesión, que corre sin tenant,
// vería cero filas. Aserciones 17 y 61.
// =============================================================================

/// Una persona. Global: existe antes de elegir agencia. Solo `viajapro_identidad`.
model Identidad {
  id               String    @id @default(uuid(7)) @db.Uuid
  /// citext: mayúsculas distintas no son dos personas.
  correo           String    @unique @db.Citext
  correoVerificado Boolean   @default(false) @map("correo_verificado")
  nombre           String    @db.VarChar(200)
  creadoEn         DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn    DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn      DateTime? @map("eliminado_en") @db.Timestamptz(3)

  credenciales Credencial[]
  sesiones     Sesion[]
  accesos      AccesoIdentidad[]
  pertenencias Usuario[]

  @@map("identidades")
}

/// Contraseña (scrypt) u otro proveedor de una identidad. Solo `viajapro_identidad`.
model Credencial {
  id             String    @id @default(uuid(7)) @db.Uuid
  identidadId    String    @map("identidad_id") @db.Uuid
  identidad      Identidad @relation(fields: [identidadId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  /// `credential` para correo y contraseña.
  proveedor      String    @db.VarChar(50)
  hashContrasena String?   @map("hash_contrasena")
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@unique([identidadId, proveedor])
  @@map("credenciales")
}

/// Sesión opaca en cookie. Solo `viajapro_identidad`.
///
/// `token` debe guardarse HASHEADO (ADR-0011). `tenantActivoId` no autoriza nada: el paso 4
/// del flujo lo comprueba leyendo `usuarios` bajo RLS.
model Sesion {
  id             String    @id @default(uuid(7)) @db.Uuid
  identidadId    String    @map("identidad_id") @db.Uuid
  identidad      Identidad @relation(fields: [identidadId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  token          String    @unique
  expiraEn       DateTime  @map("expira_en") @db.Timestamptz(3)
  tenantActivoId String?   @map("tenant_activo_id") @db.Uuid
  tenantActivo   Tenant?   @relation(fields: [tenantActivoId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  ip             String?   @db.VarChar(45)
  agenteUsuario  String?   @map("agente_usuario")
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([identidadId])
  @@index([expiraEn])
  @@index([tenantActivoId])
  @@map("sesiones")
}

/// Códigos de un solo uso y de recuperación. `valor` debe guardarse hasheado. Solo
/// `viajapro_identidad`.
model Verificacion {
  id            String   @id @default(uuid(7)) @db.Uuid
  identificador String
  valor         String
  expiraEn      DateTime @map("expira_en") @db.Timestamptz(3)
  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([identificador])
  @@index([expiraEn])
  @@map("verificaciones")
}

/// En qué agencias está una identidad, para el selector. **Índice, no autoridad.**
///
/// `viajapro_identidad` solo la lee; la escribe el disparador `SECURITY DEFINER` de
/// `usuarios`, propiedad de `viajapro_accesos`. Nadie más puede escribirla.
model AccesoIdentidad {
  identidadId    String    @map("identidad_id") @db.Uuid
  identidad      Identidad @relation(fields: [identidadId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  tenantAccesoId String    @map("tenant_acceso_id") @db.Uuid
  tenant         Tenant    @relation(fields: [tenantAccesoId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@id([identidadId, tenantAccesoId])
  @@index([tenantAccesoId])
  @@map("accesos_identidad")
}

/// Rol de una agencia. **Tabla, no enum** (R12, ADR-0006): la agencia los renombra y crea
/// otros. Lo que no es configurable es el catálogo de permisos: el `CHECK` de la migración,
/// reflejo de `PERMISOS` en `packages/contracts/src/identidad.ts`.
model Rol {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre   String   @db.VarChar(80)
  /// `DUENO`, `ASESOR` u `OPERACIONES` en los tres sembrados; nula en los que crea la agencia.
  clave    String?  @db.VarChar(32)
  permisos String[] @default([])

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuarios Usuario[]

  @@unique([tenantId, nombre])
  @@unique([id, tenantId])
  @@unique([tenantId, clave])
  @@map("roles")
}

/// La pertenencia de una identidad a una agencia: en la agencia X, Ana es asesora.
///
/// Lleva tenant y RLS: es la tabla que dice quién puede ver qué. Desde ADR-0011 la persona
/// es una `Identidad` global y una misma identidad puede pertenecer a varias agencias.
/// `correo` y `nombre` se quedan como copia de presentación.
model Usuario {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  identidadId String    @map("identidad_id") @db.Uuid
  identidad   Identidad @relation(fields: [identidadId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  /// Foránea COMPUESTA: un usuario de la agencia B no lleva el rol de la A.
  rolId       String    @map("rol_id") @db.Uuid
  rol         Rol       @relation(fields: [rolId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: Restrict)

  correo String  @db.VarChar(255)
  nombre String  @db.VarChar(200)
  activo Boolean @default(true)

  ultimoAccesoEn DateTime? @map("ultimo_acceso_en") @db.Timestamptz(3)
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(3)

  oportunidadesAsignadas     Oportunidad[]            @relation("AsesorAsignado")
  contactosCreados           Contacto[]               @relation("ContactoCreadoPor")
  contactosActualizados      Contacto[]               @relation("ContactoActualizadoPor")
  oportunidadesCreadas       Oportunidad[]            @relation("OportunidadCreadoPor")
  oportunidadesActualizadas  Oportunidad[]            @relation("OportunidadActualizadoPor")
  notasEscritas              NotaInterna[]            @relation("NotaInternaAutor")
  conversacionesAsignadas    Conversacion[]           @relation("ConversacionAsignadaA")
  mensajesEnviados           Mensaje[]                @relation("MensajeAutor")
  consentimientosRegistrados ConsentimientoContacto[] @relation("ConsentimientoRegistradoPor")
  cotizacionesCreadas        Cotizacion[]             @relation("CotizacionCreadoPor")
  cotizacionesActualizadas   Cotizacion[]             @relation("CotizacionActualizadoPor")
  versionesCotizacionCreadas VersionCotizacion[]      @relation("VersionCotizacionCreadoPor")
  seguimientosAsignados      Seguimiento[]            @relation("SeguimientoAsesor")
  seguimientosCreados        Seguimiento[]            @relation("SeguimientoCreadoPor")
  seguimientosActualizados   Seguimiento[]            @relation("SeguimientoActualizadoPor")

  @@unique([tenantId, correo])
  @@unique([tenantId, identidadId])
  @@unique([id, tenantId])
  @@index([tenantId, activo])
  @@index([identidadId])
  @@index([tenantId, rolId])
  @@map("usuarios")
}

// =============================================================================
// CONFIGURACIÓN POR TENANT — R12 en acción
// =============================================================================

/// Etapas del embudo. **Tabla, no enum.**
///
/// Cada agencia tiene su proceso de venta. Un enum en el código obligaría a una migración
/// con reasignación de filas el día que la primera agencia pida una etapa distinta —
/// y ese día llega siempre. Ver ADR-0006.
model EtapaPipeline {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre       String  @db.VarChar(80)
  /// Lo que el contrato llama `EtapaPipeline`. **Nullable a proposito**: una agencia puede
  /// tener mas etapas que las cinco del contrato, y una etapa sin clave existe en la base
  /// pero hoy no es representable en la API. Forzar un valor meteria dos etapas distintas
  /// en la misma columna del tablero, que es peor que decir la verdad.
  clave        String? @db.VarChar(32)
  orden        Int     @db.SmallInt
  /// Probabilidad de cierre asociada a la etapa, para proyectar ingresos.
  probabilidad Int     @default(0) @db.SmallInt
  /// Etapas terminales: la oportunidad sale del embudo.
  esGanada     Boolean @default(false) @map("es_ganada")
  esPerdida    Boolean @default(false) @map("es_perdida")

  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  oportunidades Oportunidad[]

  @@unique([tenantId, orden])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("etapas_pipeline")
}

/// Definición de un campo personalizado.
///
/// Se diseña desde la PRIMERA migración aunque la interfaz llegue después: añadirlo más
/// tarde significa migrar datos de producción. Misma categoría que tenantId, el versionado
/// de cotizaciones y los time limits. Ver ADR-0006.
///
/// Las definiciones son relacionales (se consultan, validan y ordenan); los valores viven
/// en una columna jsonb de la propia entidad, con índice GIN. Así se evita la tabla genérica
/// clave-valor, que se degrada en cuanto hay volumen.
model DefinicionCampoPersonalizado {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  entidad     EntidadPersonalizable
  /// Clave dentro del jsonb. Estable: renombrarla rompe los datos ya guardados.
  clave       String                 @db.VarChar(64)
  etiqueta    String                 @db.VarChar(120)
  tipo        TipoCampoPersonalizado
  obligatorio Boolean                @default(false)
  orden       Int                    @default(0) @db.SmallInt
  /// Opciones para los tipos de selección.
  opciones    Json?                  @db.JsonB

  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@unique([tenantId, entidad, clave])
  @@index([tenantId, entidad])
  @@map("definiciones_campo_personalizado")
}

enum EntidadPersonalizable {
  CONTACTO
  VIAJERO
  OPORTUNIDAD
  ARCHIVO_VIAJE
  /// ADR-0017 M2: los campos propios de la agencia en su catálogo.
  PAQUETE

  @@map("entidad_personalizable")
}

enum TipoCampoPersonalizado {
  TEXTO
  NUMERO
  FECHA
  BOOLEANO
  SELECCION
  SELECCION_MULTIPLE

  @@map("tipo_campo_personalizado")
}

// =============================================================================
// CATÁLOGO — el corazón de la cabeza de playa
// =============================================================================

/// Quien arma el paquete y se lo vende a la agencia.
model Mayorista {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre              String  @db.VarChar(200)
  /// Identificador canónico global del proveedor.
  ///
  /// Hoy no se usa. Existe porque sin él, el "Hotel Las Américas" de una agencia y el de otra
  /// son entidades distintas para siempre, y la calificación compartida de proveedores
  /// —el horizonte de la red entre agencias— sería imposible sin reconciliar a mano.
  /// Cuesta una columna ahora; cuesta un proyecto después.
  proveedorCanonicoId String? @map("proveedor_canonico_id") @db.Uuid

  contactoNombre   String? @map("contacto_nombre") @db.VarChar(200)
  contactoCorreo   String? @map("contacto_correo") @db.VarChar(255)
  contactoTelefono String? @map("contacto_telefono") @db.VarChar(32)
  /// Días que da el mayorista para pagar antes de liberar el cupo. Valor por defecto
  /// del time limit cuando se crea una reserva con él.
  diasTimeLimit    Int?    @map("dias_time_limit") @db.SmallInt
  notas            String? @db.Text

  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  paquetes Paquete[]
  tarifas  Tarifa[]

  @@unique([id, tenantId])
  @@index([tenantId, eliminadoEn])
  @@index([tenantId, nombre])
  @@map("mayoristas")
}

/// Un paquete turístico: producto ya armado que la agencia revende.
model Paquete {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mayoristaId String?    @map("mayorista_id") @db.Uuid
  /// Foranea COMPUESTA con el tenant; en SQL es `SET NULL ("mayorista_id")`, que Prisma no modela.
  mayorista   Mayorista? @relation(fields: [mayoristaId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Restrict)

  nombre  String  @db.VarChar(200)
  destino String  @db.VarChar(120)
  paisIso String? @map("pais_iso") @db.Char(2)
  /// Duración declarada. Se guardan ambas porque el sector habla de "7 días / 6 noches"
  /// y no siempre se deduce una de la otra (vuelos nocturnos, salidas de madrugada).
  dias    Int     @db.SmallInt
  noches  Int     @db.SmallInt

  /// Nulo = no aplica o no se declaró: un pasadía no tiene régimen (ADR-0017 M2). Antes era
  /// obligatorio y la semilla mentía con `SIN_ALIMENTACION`.
  planAlimentacion PlanAlimentacion? @map("plan_alimentacion")
  /// Qué incluye, como lista de líneas legibles. No se modela cada servicio por separado:
  /// el paquete ya viene armado. Cuando llegue el armado a medida, serán QuoteItem.
  inclusiones      Json              @default("[]") @db.JsonB
  exclusiones      Json              @default("[]") @db.JsonB
  descripcion      String?           @db.Text

  /// Clave natural preferente entre dos cargas (ADR-0017 §3); el nombre no es clave. Única por
  /// agencia entre los no borrados: índice PARCIAL `paquetes_tenant_id_codigo_key`
  /// (`WHERE codigo IS NOT NULL AND eliminado_en IS NULL`), que Prisma no modela y vive en la
  /// migración 20261026120100.
  codigo               String? @db.VarChar(64)
  /// Lo que se paga en destino y NO entra en el total: `[{ concepto, monto, unidad, nota? }]`.
  /// La forma la protege Zod; la base solo exige que sea una lista.
  cargosEnDestino      Json    @default("[]") @map("cargos_en_destino") @db.JsonB
  /// Valores de los campos propios de la agencia (definiciones con entidad PAQUETE).
  camposPersonalizados Json    @default("{}") @map("campos_personalizados") @db.JsonB

  /// Foránea COMPUESTA con el tenant. Un formato en uso no se borra: se desactiva.
  formatoId String?         @map("formato_id") @db.Uuid
  formato   FormatoDeViaje? @relation(fields: [formatoId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: Restrict)

  activo        Boolean   @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  temporadas          Temporada[]
  vigencias           Vigencia[]
  opcionesDeSalida    OpcionDeSalida[]
  oportunidades       Oportunidad[]
  versionesCotizacion VersionCotizacion[]

  @@unique([id, tenantId])
  @@index([tenantId, activo, eliminadoEn])
  @@index([tenantId, destino])
  @@index([tenantId, formatoId])
  @@index([camposPersonalizados(ops: JsonbPathOps)], type: Gin, map: "paquetes_campos_personalizados_idx")
  @@map("paquetes")
}

/// Tipo de producto de la agencia: excursión de un día, pasadía, pasanoche, paquete con hotel…
/// El `TripFormat` de ADR-0009 §4, con la plantilla de ENTRADA de ADR-0017 §4.2.
///
/// Tabla por agencia, no enum (R12): cada agencia recibe copias editables de los formatos de
/// sistema, como recibe sus roles. **Ninguna ruta de cálculo ramifica sobre el formato.**
model FormatoDeViaje {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre    String  @db.VarChar(80)
  orden     Int     @default(0) @db.SmallInt
  activo    Boolean @default(true)
  /// `PlantillaDeFormato` (Zod, `packages/contracts`): campos que se piden, obligatorios,
  /// campos personalizados que aplican y valores por defecto. Solo entrada y presentación.
  plantilla Json    @default("{}") @db.JsonB

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  paquetes Paquete[]

  @@unique([id, tenantId])
  @@unique([tenantId, nombre])
  @@map("formatos_de_viaje")
}

/// La variante de operación que el viajero elige dentro del mismo producto: un turno (City Tour
/// mañana o tarde), una modalidad con su punto de recogida (lancha o terrestre), o el hotel.
/// ADR-0017 §3.1. Una tarifa puede atarse a una; sin opción, vale para todas.
///
/// Las horas son `time` SIN zona: hora local del punto de encuentro, como la fecha de viaje es
/// `date` (R9). Pasarlas a UTC las rompería con el cambio de huso.
model OpcionDeSalida {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  paqueteId String  @map("paquete_id") @db.Uuid
  /// Foránea COMPUESTA con el tenant: una agencia no cuelga una opción del paquete de otra.
  paquete   Paquete @relation(fields: [paqueteId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  etiqueta         String    @db.VarChar(120)
  horaSalida       DateTime? @map("hora_salida") @db.Time(0)
  horaRegreso      DateTime? @map("hora_regreso") @db.Time(0)
  puntoDeEncuentro String?   @map("punto_de_encuentro") @db.VarChar(300)
  orden            Int       @default(0) @db.SmallInt
  /// Una opción referenciada por tarifas no se borra: se desactiva.
  activa           Boolean   @default(true)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  tarifas             Tarifa[]
  versionesCotizacion VersionCotizacion[]

  @@unique([id, tenantId])
  @@unique([paqueteId, etiqueta])
  @@index([tenantId, paqueteId])
  @@map("opciones_de_salida")
}

enum PlanAlimentacion {
  TODO_INCLUIDO
  DESAYUNO
  MEDIA_PENSION
  PENSION_COMPLETA
  SIN_ALIMENTACION

  @@map("plan_alimentacion")
}

/// Rango de fechas con precio propio: temporada alta, baja, puente festivo.
///
/// En Colombia los puentes festivos son su propia temporada y pueden costar como la alta.
model Temporada {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  paqueteId String  @map("paquete_id") @db.Uuid
  /// Foranea COMPUESTA con el tenant: la integridad referencial se evalua por encima de RLS.
  paquete   Paquete @relation(fields: [paqueteId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  nombre String   @db.VarChar(80)
  /// Fechas de viaje, sin hora: el 24 de diciembre es el 24 en cualquier huso. R9.
  desde  DateTime @db.Date
  hasta  DateTime @db.Date

  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  precios Precio[]

  @@unique([id, tenantId])
  @@index([tenantId, paqueteId])
  @@index([tenantId, desde, hasta])
  @@map("temporadas")
}

/// Precio de un paquete, por temporada, acomodación y tipo de pasajero.
///
/// **Aquí está la trampa del dominio.** El precio NO es "por pasajero": es *por persona en
/// acomodación X*, y baja cuanto más gente comparte la habitación. Cuatro personas en dos
/// dobles no cuestan lo mismo que cuatro en una cuádruple.
///
/// Un modelo con un solo precio por pasajero está mal y se descubre con el primer cliente.
/// Ver packages/domain/ocupacion.ts y docs/01-producto/02-lenguaje-ubicuo.md.
model Precio {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  temporadaId String    @map("temporada_id") @db.Uuid
  /// Foranea COMPUESTA con el tenant: la integridad referencial se evalua por encima de RLS.
  temporada   Temporada @relation(fields: [temporadaId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  acomodacion  Acomodacion
  tipoPasajero TipoPasajero @map("tipo_pasajero")

  /// Dinero en la unidad mínima de la moneda. R8. Ver packages/domain/money.ts.
  /// La tarifa neta es lo que cobra el mayorista: NUNCA se muestra al cliente.
  netoUnidades  BigInt @map("neto_unidades")
  /// La venta sugerida. El markup efectivo es venta - neto, y puede ajustarse por cotización.
  ventaUnidades BigInt @map("venta_unidades")
  monedaIso     String @map("moneda_iso") @db.Char(3)

  /// Edad de corte para este tipo de pasajero. "Niño de 2 a 11 años" es condición comercial
  /// real del tarifario y cambia entre mayoristas.
  edadMinima Int? @map("edad_minima") @db.SmallInt
  edadMaxima Int? @map("edad_maxima") @db.SmallInt

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@unique([tenantId, temporadaId, acomodacion, tipoPasajero, edadMinima, edadMaxima])
  @@index([tenantId, temporadaId])
  @@map("precios")
}

enum Acomodacion {
  SENCILLA
  DOBLE
  TRIPLE
  CUADRUPLE

  @@map("acomodacion")
}

enum TipoPasajero {
  ADT
  CHD
  INF

  @@map("tipo_pasajero")
}

/// La ventana de fechas a la que cuelga el precio. ADR-0009 §1.
///
/// **Una salida programada es la vigencia de un solo dia, publicada.** No hay dos tablas: esa
/// unificacion es lo que permite que la agencia que publica fechas y la que cotiza contra fecha
/// elegida por el cliente compartan UNA sola funcion de resolucion (`resolverVigencia`).
model Vigencia {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  paqueteId String  @map("paquete_id") @db.Uuid
  /// Foranea COMPUESTA con el tenant: la integridad referencial se evalua por encima de RLS, asi
  /// que una foranea simple deja colgar una vigencia del paquete de otra agencia.
  paquete   Paquete @relation(fields: [paqueteId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// Ambos extremos incluidos. `desde = hasta` es un solo dia.
  desde DateTime @db.Date
  hasta DateTime @db.Date

  /// Publicada = el cliente la ve como fecha ofrecida en la pieza de WhatsApp.
  /// Solo se publica una fecha concreta: lo garantiza un CHECK, no solo el contrato.
  publicada Boolean @default(false)

  /// Cupo INFORMATIVO. Para un revendedor el inventario de sillas es del mayorista: la
  /// disponibilidad se pregunta, no se calcula. Nulo es lo normal.
  cupoTotal Int?    @map("cupo_total") @db.SmallInt
  activa    Boolean @default(true)

  tarifas Tarifa[]

  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@unique([id, tenantId])
  @@unique([tenantId, paqueteId, desde, hasta])
  @@index([tenantId, paqueteId, desde, hasta])
  @@map("vigencias")
}

/// El precio. Cuelga de la vigencia, nunca del paquete.
model Tarifa {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  vigenciaId String   @map("vigencia_id") @db.Uuid
  vigencia   Vigencia @relation(fields: [vigenciaId, tenantId], references: [id, tenantId], onDelete: Cascade)

  /// Lo que ve el asesor: «Adulto», «Menor de 2 a 11», «Promo pareja», «Suplemento sencilla».
  nombre String @db.VarChar(80)

  /// El denominador. Es aritmetica, no politica: por eso es enum y no tabla por tenant (R12).
  unidad         UnidadDeCobro @default(POR_PERSONA)
  /// Cuantos pasajeros cubre el importe. Siempre 1 en POR_PERSONA, lo exige un CHECK.
  cubrePasajeros Int           @default(1) @map("cubre_pasajeros") @db.SmallInt

  /// Dinero en la unidad minima de la moneda. R8. En COP esa unidad es el PESO.
  /// NULO es legitimo: la tarifa cotiza igual y el margen sale como desconocido, que es la
  /// verdad mientras no llegue la hoja de netos del mayorista (ADR-0009 §5).
  netoUnidades  BigInt? @map("neto_unidades")
  ventaUnidades BigInt  @map("venta_unidades")
  monedaIso     String  @map("moneda_iso") @db.Char(3)

  /// De quien se compra ESTA silla en ESTA fecha. Baja del paquete a la tarifa porque dos
  /// vigencias del mismo paquete pueden comprarse a mayoristas distintos.
  mayoristaId String?    @map("mayorista_id") @db.Uuid
  /// `Restrict` y no `SetNull`: una foranea COMPUESTA con `SET NULL` pondria a NULL tambien
  /// `tenant_id`, que es NOT NULL. PostgreSQL acepta el DDL y revienta en ejecucion. Ademas
  /// `mayoristas` se borra en blando, asi que restringir es lo correcto para el negocio.
  mayorista   Mayorista? @relation(fields: [mayoristaId, tenantId], references: [id, tenantId], onDelete: Restrict)

  /// Si suma al precio base en vez de reemplazarlo: asi es el suplemento de sencilla.
  aditiva Boolean @default(false)

  /// La condicion es DECLARATIVA y cerrada, no una expresion evaluable. Todo nulo = aplica
  /// siempre, que es el caso de casi todas las lineas de un tarifario real.
  acomodacion     Acomodacion?
  tipoPasajero    TipoPasajero? @map("tipo_pasajero")
  edadMinima      Int?          @map("edad_minima") @db.SmallInt
  edadMaxima      Int?          @map("edad_maxima") @db.SmallInt
  pasajerosMinimo Int?          @map("pasajeros_minimo") @db.SmallInt
  pasajerosMaximo Int?          @map("pasajeros_maximo") @db.SmallInt
  ocupaSilla      Boolean?      @map("ocupa_silla")

  /// Precio de lista, el que se muestra tachado (ADR-0017 §9). Misma moneda y unidad mínima que
  /// la venta; un CHECK exige `lista > venta`. **Nunca entra en el cálculo ni en la cotización.**
  listaUnidades BigInt?   @map("lista_unidades")
  /// Fin de la promo: fecha de calendario, fin del día en la zona del tenant (R9). Nulo = sin fin.
  /// Al vencer, la venta NO cambia sola; qué se muestra lo decide `promo_vencida`.
  promoHasta    DateTime? @map("promo_hasta") @db.Date

  /// Nula = vale para todas las opciones del producto. Foránea COMPUESTA con el tenant; que la
  /// opción sea del mismo paquete que la vigencia lo valida el núcleo, no la base.
  opcionDeSalidaId String?         @map("opcion_de_salida_id") @db.Uuid
  opcionDeSalida   OpcionDeSalida? @relation(fields: [opcionDeSalidaId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: Restrict)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@index([tenantId, vigenciaId])
  @@index([tenantId, opcionDeSalidaId])
  @@map("tarifas")
}

/// Como forma el precio de venta esta agencia. ADR-0009 §2, eje 2. Nivel 1 de ADR-0006.
///
/// Una fila por tenant. Lo que decide aqui NO altera ninguna cotizacion ya enviada: una
/// cotizacion congela sus numeros, y ese invariante no es configurable.
model PoliticaDePrecio {
  tenantId String @id @map("tenant_id") @db.Uuid

  /// Eje 1: afecta a las altas y a la interfaz, NUNCA al calculo.
  modoDeCatalogo ModoDeCatalogo @default(AMBOS) @map("modo_de_catalogo")

  /// Puntos porcentuales. Admite decimales: 12,5 es valido.
  porcentaje Decimal @default(20) @db.Decimal(6, 3)

  /// «Margen del 20 %» tiene DOS lecturas y dan precios distintos: sobre un neto de un millon,
  /// SOBRE_EL_NETO da 1.200.000 y SOBRE_LA_VENTA da 1.250.000. El propietario fijo la primera
  /// el 2026-10-13; la agencia que cobre comision cambia este campo y nada mas.
  base BaseDelMargen @default(SOBRE_EL_NETO)

  /// Quien manda cuando el mayorista sube su neto: el porcentaje o el numero de la hoja.
  origenDeLaVenta OrigenDeLaVenta @default(DERIVADA_DEL_NETO) @map("origen_de_la_venta")

  /// Paso de redondeo de la VENTA, en unidades minimas. Nunca se redondea el neto: es lo que
  /// cobra el mayorista. Existe porque ninguna hoja colombiana publica $1.236.432.
  redondeoVenta Int @default(1000) @map("redondeo_venta")

  admiteMargenPorTarifa Boolean @default(true) @map("admite_margen_por_tarifa")

  /// Qué se MUESTRA cuando venció la promo de una tarifa (ADR-0017 §9, D3). Política de
  /// presentación, nunca de cálculo: la venta no cambia sola en ningún valor.
  promoVencida PromoVencida @default(OCULTAR) @map("promo_vencida")

  actualizadaEn DateTime @updatedAt @map("actualizada_en") @db.Timestamptz(3)

  @@map("politicas_de_precio")
}

enum UnidadDeCobro {
  POR_PERSONA
  POR_GRUPO

  @@map("unidad_de_cobro")
}

enum BaseDelMargen {
  SOBRE_EL_NETO
  SOBRE_LA_VENTA

  @@map("base_del_margen")
}

enum OrigenDeLaVenta {
  DERIVADA_DEL_NETO
  FIJADA_EN_EL_TARIFARIO

  @@map("origen_de_la_venta")
}

enum ModoDeCatalogo {
  SALIDAS_PUBLICADAS
  VIGENCIA_ABIERTA
  AMBOS

  @@map("modo_de_catalogo")
}

/// OCULTAR (por defecto): solo la venta vigente. TACHAR: la lista tachada con «promo vencida».
enum PromoVencida {
  OCULTAR
  TACHAR

  @@map("promo_vencida")
}

// =============================================================================
// CANALES — la verdad sobre la conexión de WhatsApp de cada agencia
//
// Estas dos tablas SÍ son de negocio: llevan tenant_id y RLS como todas. Aquí viven
// los identificadores de Meta **en claro** y los tokens cifrados de terceros, bajo
// aislamiento. El directorio global de ADR-0008 es una proyección DERIVADA de esto:
// si se pierde la pimienta, el directorio se reconstruye recorriendo estas tablas.
// =============================================================================

/// Cuenta de WhatsApp Business (WABA) que la agencia conecta por Embedded Signup.
///
/// Existe como entidad propia, y no como una columna de `Canal`, por dos razones del
/// ADR-0008: el token de negocio que devuelve el canje se emite **sobre el WABA**, no
/// sobre un número; y los webhooks de plantillas y de cuenta **no traen
/// `phone_number_id`**, solo el WABA en `entry[].id`, de modo que el historial del
/// directorio necesita una referencia propia y estable a la cuenta (`cuenta_id`) para
/// no quedar huérfano justo en las filas que gobiernan los eventos de gestión.
model CuentaWhatsapp {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Identificador de Meta, en claro y bajo RLS. **Atributo reasignable, no clave**:
  /// Meta no garantiza su inmutabilidad y un número migrado entre WABAs cambia de cuenta.
  wabaId String      @map("waba_id") @db.VarChar(32)
  nombre String?     @db.VarChar(200)
  estado EstadoCanal @default(ACTIVO)

  /// Token de negocio cifrado con AES-256-GCM desde el proceso (R6). Nunca en claro,
  /// nunca con la clave viajando dentro del SQL.
  tokenCifrado Bytes? @map("token_cifrado")
  tokenNonce   Bytes? @map("token_nonce")
  tokenTag     Bytes? @map("token_tag")
  claveVersion Int?   @map("clave_version") @db.SmallInt

  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  /// Cronología del canal: vive aquí, bajo RLS, y no en el directorio global, donde
  /// las fechas eran el libro de clientes servido a quien pudiera leerlo.
  revocadoEn     DateTime? @map("revocado_en") @db.Timestamptz(3)
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(3)
  creadoPor      String?   @map("creado_por") @db.Uuid
  actualizadoPor String?   @map("actualizado_por") @db.Uuid

  canales       Canal[]
  enrutamientos EnrutamientoCanal[]
  plantillas    PlantillaWhatsapp[]

  /// Sostiene la clave foránea compuesta de `canales` **y la del directorio**: la misma
  /// unicidad que ya existía es la que respalda ahora las filas WABA.
  @@unique([id, tenantId])
  @@unique([tenantId, wabaId])
  @@index([tenantId, estado])
  @@map("cuentas_whatsapp")
}

/// Un número de WhatsApp conectado. Es el `Canal` del lenguaje ubicuo.
///
/// El `phone_number_id` **no** es la clave primaria, y eso importa: un número borrado y
/// vuelto a añadir no conserva el suyo. El canal es una entidad nuestra con UUID propio;
/// los identificadores de Meta son atributos reasignables. Tratarlos como clave habría
/// convertido la migración de número de un cliente en una cirugía de claves foráneas.
model Canal {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cuentaId String         @map("cuenta_id") @db.Uuid
  /// Clave foránea compuesta: un canal no puede colgar de la cuenta de otro tenant.
  cuenta   CuentaWhatsapp @relation(fields: [cuentaId, tenantId], references: [id, tenantId], onDelete: Cascade)

  tipo          TipoCanal   @default(WHATSAPP)
  phoneNumberId String      @map("phone_number_id") @db.VarChar(32)
  /// El número tal como lo marca un cliente, en E.164.
  numeroE164    String      @map("numero_e164") @db.VarChar(20)
  nombreVisible String?     @map("nombre_visible") @db.VarChar(200)
  estado        EstadoCanal @default(ACTIVO)

  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  revocadoEn     DateTime? @map("revocado_en") @db.Timestamptz(3)
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(3)
  creadoPor      String?   @map("creado_por") @db.Uuid
  actualizadoPor String?   @map("actualizado_por") @db.Uuid

  enrutamientos  EnrutamientoCanal[]
  conversaciones Conversacion[]

  /// Sostiene la clave foránea compuesta del directorio global.
  @@unique([id, tenantId])
  /// La unicidad del identificador de Meta es POR TENANT. Global sería un oráculo:
  /// el alta de una agencia fallaría y le confirmaría que ese número ya está en la
  /// plataforma. Que un mismo identificador no pueda estar activo en dos tenants lo
  /// impone el directorio, cuya clave primaria es global.
  @@unique([tenantId, phoneNumberId])
  @@index([tenantId, estado])
  @@index([tenantId, cuentaId])
  @@map("canales")
}

enum TipoCanal {
  WHATSAPP

  @@map("tipo_canal")
}

enum EstadoCanal {
  ACTIVO
  /// Impago o investigación: se persiste lo que llegue, no se emite en vivo.
  SUSPENDIDO
  /// Agencia dada de baja. La fila no se borra: borrarla convierte a un excliente
  /// conocido en un desconocido y borra la evidencia de cuándo dejamos de tratar sus datos.
  REVOCADO

  @@map("estado_canal")
}

// =============================================================================
// CRM
//
// Sirve los contratos de `packages/contracts/src/crm.ts`. Lo que el contrato llama
// `EtapaPipeline` (enum cerrado de cinco) aquí es TABLA por tenant con una columna
// `clave`: la forma es parametrizable desde el primer día —R12— y los valores están
// cerrados mientras el contrato lo esté. Abrirlos es borrar un CHECK, no migrar filas.
// =============================================================================

/// Persona con la que la agencia conversa. Puede o no viajar.
///
/// `Contacto` != `Viajero`: quien paga no siempre viaja. Fusionarlos parece una simplificación
/// razonable hasta el primer viaje familiar, y entonces hay que rehacer el modelo con datos
/// en producción. Ver docs/01-producto/02-lenguaje-ubicuo.md.
model Contacto {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// En formato E.164 (+573001234567). Es la llave natural del canal de WhatsApp.
  telefonoE164 String  @map("telefono_e164") @db.VarChar(20)
  nombre       String? @db.VarChar(200)
  /// 320 y no 255: es la longitud máxima real de una dirección de correo, y la que
  /// declara el contrato.
  correo       String? @db.VarChar(320)

  /// Etiquetas libres por agencia: «VIP», «Luna de miel». Política de negocio, R12: no son
  /// un enum porque cada agencia inventa las suyas y ninguna migración debería hacer falta.
  etiquetas String[] @default([])

  /// Lo que conviene recordar para atender y para recomprar.
  ///
  /// **R10 — campo de riesgo.** El contrato lo describe como «alergias, asiento, aerolínea»:
  /// una alergia es dato de salud, y el dato de salud es sensible en la Ley 1581 de 2012.
  /// No se cifra por columna —el panel lateral lo lee en cada apertura de conversación y
  /// cifrarlo lo volvería ilegible para el filtro y lento de pintar—, pero sí se le niegan
  /// las dos cosas que convierten un campo así en una fuga: NO entra en el índice de
  /// búsqueda (no se puede minar preguntando) y NO viaja a `registros_auditoria.detalle`.
  preferencias String? @db.VarChar(2000)

  /// Valores de los campos personalizados. Las definiciones están en
  /// DefinicionCampoPersonalizado; aquí van los datos, con índice GIN.
  camposPersonalizados Json @default("{}") @map("campos_personalizados") @db.JsonB

  /// Lo mantiene el inbox cuando entra o sale un mensaje. Denormalizado a propósito:
  /// ordenar contactos por actividad no debe costar un recorrido de mensajes.
  ultimoContactoEn DateTime? @map("ultimo_contacto_en") @db.Timestamptz(3)

  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  /// Nulos a propósito: al contacto que llega por webhook no lo crea ningún usuario.
  creadoPorId      String?  @map("creado_por") @db.Uuid
  actualizadoPorId String?  @map("actualizado_por") @db.Uuid
  creadoPor        Usuario? @relation("ContactoCreadoPor", fields: [creadoPorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actualizadoPor   Usuario? @relation("ContactoActualizadoPor", fields: [actualizadoPorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  oportunidades   Oportunidad[]
  notasInternas   NotaInterna[]
  consentimientos ConsentimientoContacto[]
  conversaciones  Conversacion[]
  cotizaciones    Cotizacion[]
  seguimientos    Seguimiento[]

  /// Dos agencias distintas pueden tener el mismo teléfono de cliente: la unicidad
  /// es POR TENANT, nunca global.
  @@unique([tenantId, telefonoE164])
  /// Lo que permite que quien lo referencie lleve clave foránea COMPUESTA. Sin esto, una
  /// oportunidad puede colgar del contacto de otra agencia y nadie lo nota.
  @@unique([id, tenantId])
  @@index([tenantId, eliminadoEn])
  @@index([tenantId, ultimoContactoEn(sort: Desc)])
  @@map("contactos")
}

/// Para qué nos dio permiso el contacto, con su prueba y su fecha.
///
/// **Tabla y no un arreglo de enums en `contactos`.** La Ley 1581 de 2012 no pide saber si
/// hay consentimiento: pide poder demostrar cuándo, por qué canal y con qué finalidad se
/// obtuvo, y que la revocación quede registrada. Un arreglo de dos valores no demuestra
/// nada y se sobrescribe sin dejar rastro. El contrato expone
/// `consentimientos: Consentimiento[]`, que es la proyección de las filas vigentes.
model ConsentimientoContacto {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactoId String   @map("contacto_id") @db.Uuid
  contacto   Contacto @relation(fields: [contactoId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  finalidad Consentimiento
  /// De dónde salió: «whatsapp:wamid...», «formulario-web», «importacion-csv». Es la prueba.
  prueba    String         @db.VarChar(200)
  canal     String?        @db.VarChar(40)

  otorgadoEn DateTime  @default(now()) @map("otorgado_en") @db.Timestamptz(3)
  revocadoEn DateTime? @map("revocado_en") @db.Timestamptz(3)

  registradoPorId String?  @map("registrado_por") @db.Uuid
  registradoPor   Usuario? @relation("ConsentimientoRegistradoPor", fields: [registradoPorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  /// En la base es un índice PARCIAL (`WHERE revocado_en IS NULL`): una finalidad vigente
  /// por contacto, conservando entero el histórico de las revocadas. Prisma no modela el
  /// `WHERE`; lo pone la migración con este mismo nombre, igual que `idx_outbox_pendientes`.
  @@unique([tenantId, contactoId, finalidad], map: "ux_consentimiento_vigente")
  @@index([tenantId, contactoId])
  @@map("consentimientos_contacto")
}

enum Consentimiento {
  TRANSACCIONAL
  PROMOCIONAL

  @@map("consentimiento")
}

/// Una intención de compra en el embudo.
model Oportunidad {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Clave foránea COMPUESTA con el tenant, como todas las de aquí abajo. Escrita simple
  /// —como estaba— la oportunidad de una agencia podía colgar del contacto de otra: RLS no
  /// interviene, porque la integridad referencial se comprueba por encima de las políticas.
  contactoId String   @map("contacto_id") @db.Uuid
  contacto   Contacto @relation(fields: [contactoId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  etapaId String        @map("etapa_id") @db.Uuid
  etapa   EtapaPipeline @relation(fields: [etapaId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  /// `Restrict` y no `SetNull`: la clave compuesta incluye `tenant_id`, que es NOT NULL, y
  /// PostgreSQL no puede anular media clave. No estorba: los usuarios se borran lógicamente.
  asesorId String?  @map("asesor_id") @db.Uuid
  asesor   Usuario? @relation("AsesorAsignado", fields: [asesorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  /// El paquete del catálogo, si ya se eligió uno. Null mientras se explora.
  paqueteId String?  @map("paquete_id") @db.Uuid
  paquete   Paquete? @relation(fields: [paqueteId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  titulo  String  @db.VarChar(200)
  destino String? @db.VarChar(120)

  /// Intención de viaje extraída de la conversación. `fecha_viaje_desde` es lo que el
  /// contrato llama `fechaSalida`. `date` y no `timestamptz`: un vuelo del 24 es del 24
  /// en cualquier huso. R9.
  fechaViajeDesde DateTime? @map("fecha_viaje_desde") @db.Date
  fechaViajeHasta DateTime? @map("fecha_viaje_hasta") @db.Date
  adultos         Int?      @db.SmallInt
  ninos           Int?      @db.SmallInt
  infantes        Int?      @db.SmallInt

  /// Valor estimado, en la unidad mínima de la moneda. R8: entero de 64 bits, nunca coma
  /// flotante. Viaja por la API como cadena porque JSON no tiene enteros de 64 bits.
  valorEstimadoUnidades BigInt? @map("valor_estimado_unidades")
  monedaIso             String? @map("moneda_iso") @db.Char(3)

  /// Probabilidad de cierre de ESTA oportunidad. La de la etapa es el valor por defecto;
  /// esta es la del asesor cuando la corrige. CHECK entre 0 y 100 en la migración.
  probabilidad Int? @db.SmallInt

  /// Lo siguiente que hay que hacer, y cuándo. Tres columnas y no una tabla `tareas`: el
  /// contrato expone UNA próxima tarea, y una tabla para una fila por oportunidad añade un
  /// join a la consulta más caliente del producto a cambio de nada que hoy se use. Un CHECK
  /// exige que estén las tres o ninguna. El día que haga falta historial de tareas es una
  /// tabla nueva y una migración, no un rediseño.
  proximaTareaDescripcion String?   @map("proxima_tarea_descripcion") @db.VarChar(200)
  proximaTareaVenceEn     DateTime? @map("proxima_tarea_vence_en") @db.Timestamptz(3)
  proximaTareaCompletada  Boolean?  @map("proxima_tarea_completada")

  /// Por qué se perdió. Enum del motor y no tabla por tenant: ver el informe de la
  /// migración. El texto libre es obligatorio cuando el motivo es OTRO, y lo exige un CHECK.
  motivoPerdida MotivoPerdida? @map("motivo_perdida")
  notaPerdida   String?        @map("nota_perdida") @db.VarChar(500)

  camposPersonalizados Json @default("{}") @map("campos_personalizados") @db.JsonB

  ultimoContactoEn DateTime? @map("ultimo_contacto_en") @db.Timestamptz(3)

  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  cerradaEn     DateTime? @map("cerrada_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  creadoPorId      String?  @map("creado_por") @db.Uuid
  actualizadoPorId String?  @map("actualizado_por") @db.Uuid
  creadoPor        Usuario? @relation("OportunidadCreadoPor", fields: [creadoPorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actualizadoPor   Usuario? @relation("OportunidadActualizadoPor", fields: [actualizadoPorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  cotizaciones Cotizacion[]
  seguimientos Seguimiento[]

  @@unique([id, tenantId])
  /// Destino de la foránea de tres columnas de `cotizaciones` y de `seguimientos`: la oportunidad de una cotización
  /// tiene que ser del MISMO contacto que la cotización.
  @@unique([id, contactoId, tenantId])
  /// El tablero: una consulta por columna, filtrada por tenant y ordenada por actividad.
  @@index([tenantId, etapaId, actualizadoEn(sort: Desc)])
  @@index([tenantId, asesorId])
  @@index([tenantId, contactoId])
  @@index([tenantId, paqueteId])
  /// Las tareas que vencen. Parcial en la migración: solo las no completadas y vivas.
  @@index([tenantId, proximaTareaVenceEn], map: "idx_oportunidades_tareas_pendientes")
  @@map("oportunidades")
}

/// Por qué se perdió una oportunidad.
enum MotivoPerdida {
  PRECIO
  TIEMPO_DE_RESPUESTA
  SIN_DISPONIBILIDAD
  COMPRO_EN_OTRA_AGENCIA
  VIAJE_APLAZADO
  NO_RESPONDE
  OTRO

  @@map("motivo_perdida")
}

/// Nota interna sobre un contacto. La escribe el asesor; el cliente no la ve jamás.
model NotaInterna {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactoId String   @map("contacto_id") @db.Uuid
  contacto   Contacto @relation(fields: [contactoId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  /// Nulo si la escribió una automatización. El contrato pide `autorNombre`, que sale del join.
  autorId String?  @map("autor_id") @db.Uuid
  autor   Usuario? @relation("NotaInternaAutor", fields: [autorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  /// La conversación en cuyo hilo se escribió, si se escribió desde la bandeja.
  ///
  /// Nulo para las notas del panel del contacto, que no cuelgan de ningún hilo. El
  /// contrato `ConversacionDetalle.notas` se sirve de aquí: la nota sigue siendo del
  /// CONTACTO —es lo que un asesor quiere recordar de la persona, no del hilo— y el
  /// ancla solo dice dónde se escribió. Columna anulable y añadida en caliente: no
  /// reescribe ninguna fila existente.
  conversacionId String?       @map("conversacion_id") @db.Uuid
  conversacion   Conversacion? @relation(fields: [conversacionId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Restrict)

  texto String @db.VarChar(2000)

  escritaEn   DateTime  @default(now()) @map("escrita_en") @db.Timestamptz(3)
  eliminadaEn DateTime? @map("eliminada_en") @db.Timestamptz(3)

  @@index([tenantId, contactoId, escritaEn(sort: Desc)])
  @@index([tenantId, conversacionId, escritaEn(sort: Desc)])
  @@map("notas_internas")
}

/// Algo que un asesor se comprometió a hacer, con fecha, sobre una oportunidad o sobre una
/// conversación — exactamente una de las dos (CHECK `seguimientos_exactamente_un_destino`).
/// T-082. Sustituye a las columnas `proxima_tarea_*` de `oportunidades` como fuente de los
/// seguimientos: aquí caben varios por oportunidad y también los de una conversación.
model Seguimiento {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  descripcion  String    @db.VarChar(200)
  venceEn      DateTime  @map("vence_en") @db.Timestamptz(3)
  /// Nulo mientras esté pendiente.
  completadoEn DateTime? @map("completado_en") @db.Timestamptz(3)

  /// Nulo solo si lo creó una automatización sin dueño. Compuesta con el tenant.
  asesorId String?  @map("asesor_id") @db.Uuid
  asesor   Usuario? @relation("SeguimientoAsesor", fields: [asesorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  /// Denormalizado del destino para pintar «pendientes del día» sin un join condicional.
  contactoId String   @map("contacto_id") @db.Uuid
  contacto   Contacto @relation(fields: [contactoId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  /// Foránea de TRES columnas: la oportunidad es de esta agencia y de este mismo contacto.
  oportunidadId String?      @map("oportunidad_id") @db.Uuid
  oportunidad   Oportunidad? @relation(fields: [oportunidadId, contactoId, tenantId], references: [id, contactoId, tenantId], onDelete: Cascade, onUpdate: Restrict)

  conversacionId String?       @map("conversacion_id") @db.Uuid
  conversacion   Conversacion? @relation(fields: [conversacionId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  creadoPorId      String?  @map("creado_por") @db.Uuid
  actualizadoPorId String?  @map("actualizado_por") @db.Uuid
  creadoPor        Usuario? @relation("SeguimientoCreadoPor", fields: [creadoPorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actualizadoPor   Usuario? @relation("SeguimientoActualizadoPor", fields: [actualizadoPorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  /// «Pendientes del día» de un asesor. PARCIAL en la migración (`WHERE completado_en IS NULL`);
  /// Prisma no modela el WHERE, igual que `idx_oportunidades_tareas_pendientes`.
  @@index([tenantId, asesorId, venceEn], map: "idx_seguimientos_pendientes_por_asesor")
  @@index([tenantId, venceEn])
  @@index([tenantId, oportunidadId])
  @@index([tenantId, conversacionId])
  @@index([tenantId, contactoId])
  @@map("seguimientos")
}

// =============================================================================
// AUDITORÍA
// =============================================================================

/// Bitácora de acciones. Solo escritura: nadie modifica ni borra un registro de auditoría.
model RegistroAuditoria {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid

  usuarioId    String?      @map("usuario_id") @db.Uuid
  /// Quién actuó (T-071): USUARIO (`usuarioId`) o CLAVE_DE_API (`claveDeApiId`). NULL = registro
  /// anterior a T-071. Un CHECK de la migración exige CLAVE_DE_API ⇔ hay clave, y sin usuario.
  tipoDeActor  TipoDeActor? @default(USUARIO) @map("tipo_de_actor")
  /// Sin relación todavía: la tabla de claves de API (ADR-0017 M3) no existe. Cuando exista, la
  /// foránea será COMPUESTA con `tenantId`.
  claveDeApiId String?      @map("clave_de_api_id") @db.Uuid
  accion       String       @db.VarChar(80)
  entidad      String       @db.VarChar(80)
  entidadId    String?      @map("entidad_id") @db.Uuid
  /// Qué cambió. Nunca contenido de mensajes ni números de documento: R10.
  detalle      Json?        @db.JsonB
  ip           String?      @db.Inet

  ocurridoEn DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(3)

  @@index([tenantId, ocurridoEn(sort: Desc)])
  @@index([tenantId, entidad, entidadId])
  @@map("registros_auditoria")
}

/// Quién escribió un registro de auditoría. Invariante del sistema, no política de la agencia
/// (R12): por eso es enum y no tabla.
enum TipoDeActor {
  USUARIO
  CLAVE_DE_API

  @@map("tipo_de_actor")
}

// =============================================================================
// EVENTOS — patrón outbox
// =============================================================================

/// Eventos de dominio pendientes de publicar.
///
/// Se escriben en la MISMA transacción que el cambio de estado; un relay los envía a BullMQ.
/// Sin esto: publicas el evento, la transacción revierte, y acabas de notificar un hecho que
/// nunca ocurrió.
model Outbox {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid

  agregado      String @db.VarChar(80)
  agregadoId    String @map("agregado_id") @db.Uuid
  tipoEvento    String @map("tipo_evento") @db.VarChar(120)
  /// Los eventos son contrato público: cambiar su forma rompe a los consumidores,
  /// igual que cambiar una API. Por eso la versión existe desde el primer día.
  versionEvento Int    @default(1) @map("version_evento") @db.SmallInt
  payload       Json   @db.JsonB

  ocurridoEn  DateTime  @default(now()) @map("ocurrido_en") @db.Timestamptz(3)
  publicadoEn DateTime? @map("publicado_en") @db.Timestamptz(3)
  intentos    Int       @default(0) @db.SmallInt

  /// Índice parcial: el relay solo busca lo no publicado, que es una fracción diminuta
  /// de la tabla. Sin `where`, el índice crecería con todo el histórico.
  @@index([ocurridoEn], map: "idx_outbox_pendientes")
  @@index([tenantId, agregado, agregadoId])
  @@map("outbox")
}

// =============================================================================
// INBOX — conversaciones, mensajes y el espejo de plantillas de Meta
//
// Sirve packages/contracts/src/inbox.ts y packages/contracts/src/plantillas.ts.
// Los contratos mandan: aquí no se inventa ningún campo que no sostenga uno suyo.
//
// Dos ejes de tiempo, y confundirlos es un defecto, no un detalle (R9):
//   · ocurrido_en  — el instante de META. Resolución de SEGUNDOS, llega DESORDENADO y
//                    puede venir del pasado (reintento de un webhook de hace horas).
//                    Es el que ordena el hilo y el que ve el viajero.
//   · creado_en    — el instante NUESTRO. Monótono, sirve para auditar y para medir
//                    cuánto tardamos en procesar. NUNCA se muestra como hora del mensaje.
// Los dos en timestamptz UTC. El huso del tenant es cosa de presentación.
// =============================================================================

/// Un hilo con un contacto por un canal. El contrato la llama ConversacionResumen.
///
/// **Una por (contacto, canal), no una por «tema».** La alternativa —abrir una conversación
/// nueva cada vez que el viajero vuelve— parece ordenada hasta que el asesor pierde el
/// historial justo cuando lo necesita: en WhatsApp el hilo es el que ve el cliente en su
/// teléfono, y partirlo en la base crea dos verdades distintas de la misma pantalla.
model Conversacion {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Clave foránea COMPUESTA con el tenant, igual que en oportunidades. RLS no interviene
  /// en la integridad referencial: sin el tenant dentro de la clave, el hilo de una
  /// agencia podía colgar del contacto de otra y nadie se enteraba.
  contactoId String   @map("contacto_id") @db.Uuid
  contacto   Contacto @relation(fields: [contactoId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  /// El número por el que entra y sale. Compuesta por el mismo motivo.
  canalId String @map("canal_id") @db.Uuid
  canal   Canal  @relation(fields: [canalId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  estado EstadoConversacion @default(ABIERTA)

  /// Restrict y no SetNull: la clave compuesta incluye tenant_id, que es NOT NULL, y
  /// PostgreSQL no puede anular media clave. Mismo razonamiento que en oportunidades.
  asignadoAId String?  @map("asignado_a_id") @db.Uuid
  asignadoA   Usuario? @relation("ConversacionAsignadaA", fields: [asignadoAId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  /// LA VENTANA DE SERVICIO, en una sola columna y no en tres.
  ///
  /// El contrato expone abierta, expiraEn y minutosRestantes; los tres son función de este
  /// instante y de now(). Guardarlos sería guardar tres copias de un dato que caduca sin
  /// que nadie escriba: una conversación cuya ventana expira a las 15:00 no recibe ningún
  /// UPDATE a las 15:00, de modo que cualquier columna «abierta» estaría mintiendo desde
  /// ese segundo. Se deriva en la consulta, y hay índice sobre esta columna para que
  /// derivarla no cueste un recorrido.
  ///
  /// Nulo mientras el cliente nunca haya escrito, que es el expiraEn nulo del contrato.
  ultimoMensajeClienteEn DateTime? @map("ultimo_mensaje_cliente_en") @db.Timestamptz(3)

  /// Vista previa de la lista. Recortada por el servidor a 200 —lo que declara el
  /// contrato—, no por la web. Denormalizada a propósito: pintar 30 filas de bandeja no
  /// puede costar 30 búsquedas del último mensaje.
  ultimoMensajeTexto     String?           @map("ultimo_mensaje_texto") @db.VarChar(200)
  ultimoMensajeEn        DateTime?         @map("ultimo_mensaje_en") @db.Timestamptz(3)
  ultimoMensajeDireccion DireccionMensaje? @map("ultimo_mensaje_direccion")

  /// Contador denormalizado. CHECK >= 0 en la migración: un contador negativo es un bug de
  /// la aplicación, y se vuelve visible en la base en vez de en la interfaz.
  mensajesSinLeer Int @default(0) @map("mensajes_sin_leer") @db.SmallInt

  /// Plazo comprometido de PRIMERA respuesta, y el instante en que se cumplió.
  ///
  /// Dos columnas y no una: el contrato pide slaVenceEn nulo «cuando ya se respondió», y
  /// borrar el plazo al responder destruye la única evidencia de si se cumplió. Se guardan
  /// las dos y la proyección anula la primera cuando la segunda existe.
  slaVenceEn         DateTime? @map("sla_vence_en") @db.Timestamptz(3)
  primeraRespuestaEn DateTime? @map("primera_respuesta_en") @db.Timestamptz(3)

  /// Etiquetas libres por agencia, R12. Mismo tratamiento que en contactos.
  etiquetas String[] @default([])

  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  /// Nulos a propósito: la conversación que abre un webhook no la crea ningún usuario.
  creadoPorId      String? @map("creado_por") @db.Uuid
  actualizadoPorId String? @map("actualizado_por") @db.Uuid

  mensajes      Mensaje[]
  notasInternas NotaInterna[]
  seguimientos  Seguimiento[]

  /// El invariante del modelo: UN hilo por contacto y canal. Es lo que permite que el
  /// webhook haga ON CONFLICT DO UPDATE sin carreras — dos mensajes del mismo viajero
  /// procesados a la vez por dos trabajadores no crean dos hilos.
  @@unique([tenantId, canalId, contactoId])
  /// Sostiene las claves foráneas compuestas de mensajes y notas_internas.
  @@unique([id, tenantId])
  /// La bandeja: filtrar por estado y ordenar por actividad, con el tenant delante.
  @@index([tenantId, estado, ultimoMensajeEn(sort: Desc)])
  @@index([tenantId, asignadoAId, ultimoMensajeEn(sort: Desc)])
  @@index([tenantId, contactoId])
  /// La ventana de servicio. Parcial en la migración: solo hilos vivos.
  @@index([tenantId, ultimoMensajeClienteEn(sort: Desc)], map: "idx_conversaciones_ventana")
  /// El filtro SLA_VENCIDO. Parcial: solo las que aún no han tenido respuesta.
  @@index([tenantId, slaVenceEn], map: "idx_conversaciones_sla_pendiente")
  @@map("conversaciones")
}

enum EstadoConversacion {
  ABIERTA
  EN_ESPERA
  CERRADA

  @@map("estado_conversacion")
}

enum DireccionMensaje {
  ENTRANTE
  SALIENTE

  @@map("direccion_mensaje")
}

/// Estado de entrega tal como lo reporta Meta.
///
/// FALLIDO es terminal y gana siempre: Meta documenta que un mismo mensaje puede emitir
/// delivered y failed, y mostrar «entregado» sobre algo que no llegó es peor que no
/// mostrar nada. Lo impone la aplicación, no un CHECK: el orden de llegada de los webhooks
/// no es un invariante de fila.
enum EstadoMensaje {
  PENDIENTE
  ENVIADO
  ENTREGADO
  LEIDO
  REPRODUCIDO
  FALLIDO

  @@map("estado_mensaje")
}

enum TipoContenido {
  TEXTO
  IMAGEN
  DOCUMENTO
  AUDIO
  VIDEO
  UBICACION
  CONTACTO
  PLANTILLA
  INTERACTIVO
  REACCION
  NO_SOPORTADO

  @@map("tipo_contenido")
}

/// El grano fino del hilo.
///
/// **La tabla que más crece del producto.** No está particionada, y la decisión está
/// razonada en la migración y en el modelo de datos: la consulta caliente lleva siempre
/// tenant_id y conversacion_id, que un btree resuelve igual con un millón de filas que con
/// cien; y particionar por ocurrido_en obligaría a meter la fecha en la clave única de
/// wamid, que es justo lo que destruiría la idempotencia de R5.
model Mensaje {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  conversacionId String       @map("conversacion_id") @db.Uuid
  conversacion   Conversacion @relation(fields: [conversacionId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  direccion DireccionMensaje
  tipo      TipoContenido
  estado    EstadoMensaje    @default(PENDIENTE)

  /// Texto plano. Nulo en los que son solo adjunto o reacción.
  ///
  /// **R10 — campo de riesgo, y el de mayor superficie del producto.** Aquí escribe el
  /// viajero: número de pasaporte, fecha de nacimiento de un menor, a veces una alergia.
  /// No se cifra por columna, y la razón es la misma que en contactos.preferencias
  /// multiplicada: el hilo se lee entero en cada apertura de conversación y el contrato
  /// ConsultarBandeja.buscar busca dentro de él. Los controles que sí se aplican están en
  /// la migración; la decisión de cifrarlo pide un ADR con auditor-seguridad, no una
  /// columna puesta en silencio.
  texto String? @db.Text

  /// El identificador de Meta: wamid.HBg... **Nulo hasta que Meta lo devuelve** en los
  /// salientes, y presente desde el primer instante en los entrantes.
  ///
  /// Único POR TENANT, con índice parcial. Es la idempotencia de R5 escrita en la base y
  /// no en el código: Meta reintenta un webhook hasta que le respondemos 200, y lo hace
  /// también cuando ya habíamos respondido pero el 200 se perdió. Sin esta unicidad, un
  /// reintento duplica el mensaje en la pantalla del asesor. El ON CONFLICT DO NOTHING del
  /// trabajador se apoya exactamente aquí.
  ///
  /// Por tenant y no global, por la misma razón que canales.phone_number_id: una unicidad
  /// global sería un oráculo que confirma a una agencia la actividad de otra.
  wamid String? @db.VarChar(128)

  /// La clave que genera el CLIENTE antes de enviar (EnviarTexto, EnviarPlantilla).
  ///
  /// Cubre la mitad que wamid no puede cubrir: entre el clic del asesor y la respuesta de
  /// Meta no existe ningún identificador, así que un doble clic o un reintento de red
  /// mandarían el mensaje dos veces —y una plantilla se COBRA dos veces y el viajero la
  /// recibe dos veces. Única por tenant, con índice parcial. R5.
  claveIdempotencia String? @map("clave_idempotencia") @db.Uuid

  /// Lo que se le muestra al asesor cuando estado es FALLIDO, ya traducido.
  motivoFallo     String? @map("motivo_fallo") @db.VarChar(500)
  /// El código crudo de Meta (131047, 470…). Se guarda APARTE, como dice el contrato:
  /// motivo_fallo es para el humano y este es para el soporte y las métricas.
  codigoErrorMeta Int?    @map("codigo_error_meta")

  /// Quién lo envió. Nulo en los entrantes y en los que manda una automatización — y un
  /// CHECK impide que un ENTRANTE tenga autor, que sería un mensaje puesto en boca del
  /// viajero.
  autorId String?  @map("autor_id") @db.Uuid
  autor   Usuario? @relation("MensajeAutor", fields: [autorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  /// La plantilla que se envió, cuando tipo es PLANTILLA. Compuesta con el tenant.
  plantillaId String?            @map("plantilla_id") @db.Uuid
  plantilla   PlantillaWhatsapp? @relation(fields: [plantillaId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  /// La cotización que este mensaje llevaba, si llevaba alguna.
  ///
  /// **Sin clave foránea, y es deliberado: la tabla cotizaciones todavía no existe.** La
  /// columna se crea ahora porque el contrato ya la expone y porque añadirla después sobre
  /// una tabla de millones de filas es caro; la clave foránea compuesta
  /// (cotizacion_id, tenant_id) entra en la migración que cree cotizaciones, que es un
  /// ALTER TABLE ... ADD CONSTRAINT ... NOT VALID seguido de VALIDATE, seguro en caliente.
  /// Mientras tanto, el aislamiento de esta columna lo da la fila: tenant_id es suyo y RLS
  /// no deja leerla desde otra agencia.
  ///
  /// **Saldada en 20261019200000**: la foránea compuesta existe, con
  /// `ON DELETE SET NULL ("cotizacion_id")` —solo esa columna, nunca `tenant_id`—.
  cotizacionId String?     @map("cotizacion_id") @db.Uuid
  cotizacion   Cotizacion? @relation(fields: [cotizacionId, tenantId], references: [id, tenantId], onDelete: SetNull, onUpdate: Restrict)

  /// El instante de META (R9). Es el que ordena el hilo y el que ve el viajero. Resolución
  /// de segundos: el desempate lo pone id, que es UUID v7 y por tanto ordenable en el
  /// tiempo. Sin ese desempate, dos mensajes del mismo segundo salen en orden distinto en
  /// cada consulta.
  ocurridoEn DateTime @map("ocurrido_en") @db.Timestamptz(3)

  /// El instante NUESTRO. Nunca se muestra como hora del mensaje.
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  adjuntos Adjunto[]

  /// Sostiene la clave foránea compuesta de adjuntos.
  @@unique([id, tenantId])
  /// LA consulta caliente: abrir un hilo. ocurrido_en y después id, el mismo orden con el
  /// que se pagina hacia atrás.
  @@index([tenantId, conversacionId, ocurridoEn(sort: Desc), id(sort: Desc)])
  /// Los índices de unicidad de wamid y clave_idempotencia son PARCIALES
  /// (WHERE ... IS NOT NULL) y los pone la migración: Prisma no modela el WHERE, y sin él
  /// los miles de salientes sin wamid chocarían entre sí.
  @@map("mensajes")
}

/// Media de WhatsApp ya descargada y guardada por nosotros.
///
/// Tabla propia y no un JSONB en mensajes: un adjunto tiene ciclo de vida propio —se
/// descarga después que el mensaje, puede fallar y reintentarse, y se purga por
/// retención—, y la clave de S3 es lo que hay que recorrer para borrar de verdad los datos
/// de una agencia que se va.
model Adjunto {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mensajeId String  @map("mensaje_id") @db.Uuid
  mensaje   Mensaje @relation(fields: [mensajeId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  tipo TipoContenido

  /// Identificador del media en Meta. Caduca y exige el token de la agencia: NUNCA se
  /// sirve al navegador. Lo que el contrato expone como url es nuestra, temporal y
  /// firmada, y se construye desde clave_objeto.
  mediaIdMeta String? @map("media_id_meta") @db.VarChar(64)
  /// Ruta en S3/MinIO, SIEMPRE con prefijo de tenant: ADR-0003 deja claro que S3 no está
  /// cubierto por RLS y que su aislamiento es responsabilidad de la aplicación.
  claveObjeto String? @map("clave_objeto") @db.VarChar(500)

  nombreArchivo String? @map("nombre_archivo") @db.VarChar(255)
  tamanoBytes   BigInt? @map("tamano_bytes")
  mimeType      String? @map("mime_type") @db.VarChar(100)

  /// Nulo mientras la descarga no haya terminado. El contrato no lo expone: la API solo
  /// emite adjuntos ya descargados.
  descargadoEn DateTime? @map("descargado_en") @db.Timestamptz(3)
  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  eliminadoEn  DateTime? @map("eliminado_en") @db.Timestamptz(3)

  @@unique([id, tenantId])
  @@index([tenantId, mensajeId])
  @@map("adjuntos")
}

// -----------------------------------------------------------------------------
// PLANTILLAS — un ESPEJO, no un registro nuestro
//
// Esta es la única tabla del esquema cuyo dueño está fuera del sistema. Meta aprueba, Meta
// rechaza y **Meta pausa sola** una plantilla cuando los destinatarios la marcan como spam,
// sin avisar y sin que nadie aquí toque una fila. De eso salen tres decisiones que no se
// parecen a las del resto del modelo:
//
//   1. La identidad NO es nuestra. El nombre es único por WABA y por IDIOMA —así lo define
//      Meta—, no por tenant a secas. Por eso la unicidad cuelga de cuenta_id y no del
//      tenant: una agencia con dos WABAs puede tener recordatorio_pago en los dos, y son
//      dos plantillas distintas con estados distintos.
//   2. El tiempo se parte en tres. actualizada_en_meta es lo que dice Meta, lo único que el
//      contrato expone; sincronizada_en es cuándo lo oímos nosotros por última vez;
//      estado_cambiado_en es desde cuándo está así. La tercera parece redundante hasta que
//      un asesor pregunta «¿desde cuándo está pausada?», que es la pregunta que se hace.
//   3. La autoría es opcional. La regla de auditoría pide creado_por y actualizado_por en
//      toda entidad de negocio; aquí van NULOS cuando el cambio vino de Meta, y eso NO es
//      un campo sin rellenar: es el dato. Nulo = lo hizo Meta. Una columna «origen» aparte
//      sería una segunda columna diciendo lo mismo.
// -----------------------------------------------------------------------------

enum CategoriaPlantilla {
  UTILIDAD
  MARKETING
  AUTENTICACION

  @@map("categoria_plantilla")
}

enum EstadoPlantilla {
  APROBADA
  PENDIENTE
  RECHAZADA
  PAUSADA
  DESHABILITADA

  @@map("estado_plantilla")
}

/// Espejo local de una plantilla de Meta.
model PlantillaWhatsapp {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// El WABA al que pertenece. Clave foránea compuesta con el tenant, y además el ámbito
  /// real de la unicidad del nombre.
  cuentaId String         @map("cuenta_id") @db.Uuid
  cuenta   CuentaWhatsapp @relation(fields: [cuentaId, tenantId], references: [id, tenantId], onDelete: Cascade, onUpdate: Restrict)

  /// El identificador que Meta le da. Nulo mientras no lo hayamos visto; útil para
  /// conciliar un renombrado. Atributo reasignable, NUNCA clave: misma lección que
  /// phone_number_id.
  metaTemplateId String? @map("meta_template_id") @db.VarChar(32)

  /// Minúsculas, dígitos y guion bajo. Un CHECK lo impone con el mismo patrón que el
  /// contrato: si entra un nombre que Meta no admite, el envío falla en producción y nadie
  /// entiende por qué.
  nombre String @db.VarChar(512)
  /// es, es_CO, en_US. La misma plantilla existe en varios idiomas y cada uno tiene SU
  /// estado: Meta puede aprobar el español y rechazar el inglés.
  idioma String @db.VarChar(10)

  categoria    CategoriaPlantilla
  estado       EstadoPlantilla    @default(PENDIENTE)
  /// Por qué está RECHAZADA o PAUSADA, en lenguaje de persona.
  motivoEstado String?            @map("motivo_estado") @db.VarChar(500)

  encabezado String? @db.VarChar(60)
  cuerpo     String  @db.VarChar(1024)
  pie        String? @db.VarChar(60)

  /// Botones y variables en JSONB y no en dos tablas hijas.
  ///
  /// Son un espejo OPACO del payload de Meta: nunca se filtra ni se ordena por su
  /// contenido, siempre se leen enteros con la plantilla, y su forma la cambia Meta sin
  /// pedirnos permiso. Dos tablas hijas serían dos políticas RLS más y dos joins en la
  /// consulta que abre el selector de plantillas, a cambio de cero consultas nuevas. Los
  /// límites del contrato —10 botones, 50 variables— los imponen dos CHECK.
  botones   Json @default("[]") @db.JsonB
  variables Json @default("[]") @db.JsonB

  /// Lo que dice Meta que cambió por última vez. Es el actualizadaEn del contrato.
  actualizadaEnMeta DateTime @map("actualizada_en_meta") @db.Timestamptz(3)
  /// Cuándo lo oímos nosotros. Si se queda atrás, el espejo está ciego y hay que avisar.
  sincronizadaEn    DateTime @default(now()) @map("sincronizada_en") @db.Timestamptz(3)
  /// Desde cuándo está en este estado. Responde «¿desde cuándo está pausada?».
  estadoCambiadoEn  DateTime @default(now()) @map("estado_cambiado_en") @db.Timestamptz(3)

  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  /// Borrado lógico = «Meta ya no la tiene». No se borra la fila: los mensajes enviados con
  /// ella siguen apuntándola, y un hilo que pierde la plantilla con la que se reabrió
  /// pierde la explicación de por qué se reabrió.
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  /// NULOS cuando el cambio lo hizo Meta. Ver la nota de arriba: el nulo es el dato.
  creadoPorId      String? @map("creado_por") @db.Uuid
  actualizadoPorId String? @map("actualizado_por") @db.Uuid

  mensajes Mensaje[]

  /// La identidad de Meta: (WABA, nombre, idioma). El tenant va delante por convención de
  /// índices y es redundante —cuenta_id ya determina el tenant por su clave compuesta—,
  /// pero deja el filtro de tenant en primera posición, que es la regla.
  @@unique([tenantId, cuentaId, nombre, idioma])
  /// Sostiene la clave foránea compuesta de mensajes.
  @@unique([id, tenantId])
  /// El selector de plantillas de la bandeja: por cuenta y por estado.
  @@index([tenantId, cuentaId, estado])
  @@map("plantillas_whatsapp")
}

// =============================================================================
// COTIZACIONES — cabecera mutable, versiones inmutables (ADR-0006, ADR-0009)
//
// La inmutabilidad NO la impone este archivo ni el caso de uso: la impone un disparador de la
// base (`versiones_cotizacion_inmutables`) que rechaza UPDATE, DELETE y TRUNCATE. Prisma no lo
// modela; la migración 20261019200000 sí, y la aserción 49 se pone en rojo si falta.
// =============================================================================

/// El ciclo de vida de una cotización. Invariante del dominio, no política: enum (R12).
enum EstadoCotizacion {
  BORRADOR
  ENVIADA
  ACEPTADA
  RECHAZADA
  VENCIDA

  @@map("estado_cotizacion")
}

/// Cotización (`Quote` en el lenguaje ubicuo). La CABECERA: a quién, en qué estado y qué
/// versión vio el cliente. Lo que se ofreció vive en `VersionCotizacion`, que no cambia.
model Cotizacion {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// `Restrict`: los contactos se borran en blando, y la cotización es la prueba de lo ofrecido.
  contactoId String   @map("contacto_id") @db.Uuid
  contacto   Contacto @relation(fields: [contactoId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  /// Foránea de TRES columnas: la oportunidad es de esta agencia y de este mismo contacto.
  oportunidadId String?      @map("oportunidad_id") @db.Uuid
  oportunidad   Oportunidad? @relation(fields: [oportunidadId, contactoId, tenantId], references: [id, contactoId, tenantId], onDelete: Restrict, onUpdate: Restrict)

  titulo String           @db.VarChar(200)
  estado EstadoCotizacion @default(BORRADOR)

  /// La versión que vio el cliente y cuándo. Las dos o ninguna (CHECK), y todo estado que no
  /// sea BORRADOR la exige (CHECK). Apunta a una versión DE ESTA cotización; en la base es
  /// `DEFERRABLE INITIALLY DEFERRED`, que Prisma no modela.
  versionEnviada         Int?               @map("version_enviada") @db.SmallInt
  enviadaEn              DateTime?          @map("enviada_en") @db.Timestamptz(3)
  versionVistaPorCliente VersionCotizacion? @relation("VersionEnviada", fields: [tenantId, id, versionEnviada], references: [tenantId, cotizacionId, numero], onDelete: NoAction, onUpdate: NoAction, map: "cotizaciones_version_enviada_fkey")

  versiones VersionCotizacion[] @relation("VersionesDeLaCotizacion")
  mensajes  Mensaje[]

  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  creadoPorId      String?  @map("creado_por") @db.Uuid
  actualizadoPorId String?  @map("actualizado_por") @db.Uuid
  creadoPor        Usuario? @relation("CotizacionCreadoPor", fields: [creadoPorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  actualizadoPor   Usuario? @relation("CotizacionActualizadoPor", fields: [actualizadoPorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  @@unique([id, tenantId])
  /// El panel lateral de la bandeja: las cotizaciones del contacto, la más reciente primero.
  @@index([tenantId, contactoId, actualizadoEn(sort: Desc)])
  @@index([tenantId, oportunidadId])
  @@map("cotizaciones")
}

/// Una versión de la cotización: la INSTANTÁNEA completa del cálculo. Inmutable desde el INSERT.
///
/// Todo lo necesario para reconstruir qué se ofreció sin mirar el catálogo, que cambia. Por eso
/// `vigenciaId` y los `tarifaId` de `lineas` son copias sin foránea: una `Restrict` bloquearía el
/// mantenimiento del catálogo y una `Cascade` borraría la prueba.
///
/// Sin `actualizadoEn` ni `actualizadoPor`: una fila que no se puede actualizar no los tiene.
model VersionCotizacion {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// `Restrict` y no `Cascade`: una acción en cascada corre como el PROPIETARIO de la tabla, que
  /// es la mitad de la salida de purga del disparador. Ver la migración.
  cotizacionId String     @map("cotizacion_id") @db.Uuid
  cotizacion   Cotizacion @relation("VersionesDeLaCotizacion", fields: [cotizacionId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  /// 1, 2, 3… por cotización. Único por (tenant, cotización).
  numero       Int        @db.SmallInt

  paqueteId          String   @map("paquete_id") @db.Uuid
  paquete            Paquete  @relation(fields: [paqueteId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)
  paqueteNombre      String   @map("paquete_nombre") @db.VarChar(200)
  destino            String   @db.VarChar(120)
  noches             Int      @db.SmallInt
  /// R9: las fechas de viaje son `date`.
  fechaSalida        DateTime @map("fecha_salida") @db.Date
  vigenciaId         String   @map("vigencia_id") @db.Uuid
  vigenciaDesde      DateTime @map("vigencia_desde") @db.Date
  vigenciaHasta      DateTime @map("vigencia_hasta") @db.Date
  deSalidaProgramada Boolean  @map("de_salida_programada")

  adultos     Int          @db.SmallInt
  ninos       Int          @db.SmallInt
  infantes    Int          @db.SmallInt
  acomodacion Acomodacion?

  /// La opción de salida con la que se cotizó (ADR-0017 §3.1, T-062). Nula = el producto no tenía
  /// opciones, o la versión es anterior a T-062. Foránea COMPUESTA con el tenant; `NoAction`: una
  /// opción citada por una versión no se borra, se desactiva.
  opcionDeSalidaId String?         @map("opcion_de_salida_id") @db.Uuid
  opcionDeSalida   OpcionDeSalida? @relation(fields: [opcionDeSalidaId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: Restrict)

  /// La política de precio TAL COMO ESTABA al congelar. Cambiarla después no toca esto.
  politicaPorcentaje Decimal         @map("politica_porcentaje") @db.Decimal(6, 3)
  politicaBase       BaseDelMargen   @map("politica_base")
  politicaOrigen     OrigenDeLaVenta @map("politica_origen")
  politicaRedondeo   Int             @map("politica_redondeo")

  /// Arreglo no vacío con la forma de `OpcionDePrecio`. El disparador de alta exige que cada
  /// línea traiga `total: { unidades, moneda }` entero y en `monedaIso`, y que sumen `ventaUnidades`.
  lineas Json @db.JsonB

  /// R8. Neto y margen nulos = desconocidos (no cero). `margen = venta − neto`, por CHECK.
  ventaUnidades  BigInt  @map("venta_unidades")
  netoUnidades   BigInt? @map("neto_unidades")
  margenUnidades BigInt? @map("margen_unidades")
  monedaIso      String  @map("moneda_iso") @db.Char(3)

  /// Hasta cuándo se sostiene el precio ofrecido.
  vigenteHasta DateTime? @map("vigente_hasta") @db.Date

  /// El instante en que se congeló (R9, UTC).
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  creadoPorId String?  @map("creado_por") @db.Uuid
  creadoPor   Usuario? @relation("VersionCotizacionCreadoPor", fields: [creadoPorId, tenantId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  enviadaEnCotizaciones Cotizacion[] @relation("VersionEnviada")

  @@unique([id, tenantId])
  @@unique([tenantId, cotizacionId, numero])
  @@index([tenantId, paqueteId])
  @@index([tenantId, opcionDeSalidaId])
  @@map("versiones_cotizacion")
}
