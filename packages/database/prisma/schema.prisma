// =============================================================================
// ViajaPro — esquema de datos
//
// Reglas que este archivo hace cumplir (ver CLAUDE.md):
//   R1  Toda tabla de negocio lleva tenantId y política RLS con USING y WITH CHECK.
//   R8  Dinero en enteros (unidad mínima de la moneda) + código ISO-4217. Nunca Float.
//   R9  Instantes en UTC (timestamptz). Las fechas de viaje son `date`, sin hora.
//   R12 Lo que cada agencia define distinto es TABLA por tenant, nunca enum en el código.
//
// Las políticas RLS NO viven aquí: Prisma no las modela. Están en prisma/policies/ y se
// aplican por migración. La prueba de aislamiento (tests/aislamiento.spec.ts) falla si una
// tabla de negocio nueva aparece sin su política.
//
// Alcance: cabeza de playa — la agencia que revende paquetes.
// Ver docs/01-producto/07-cabeza-de-playa-paquetes.md
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  // Conexión de las MIGRACIONES y el DDL, con el rol propietario.
  // Con un PostgreSQL gestionado que tiene agrupador de conexiones (Neon), debe apuntar al
  // endpoint DIRECTO: las migraciones no funcionan contra el agrupado.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ADVERTENCIA
//
// La cadena de arriba es la del rol PROPIETARIO y solo la usan las migraciones.
// La aplicación en ejecución se conecta SIEMPRE con DATABASE_APP_URL, que apunta al rol
// `viajapro_app`: sin BYPASSRLS y sin pertenecer a neon_superuser.
//
// Si la aplicación usara esta cadena se saltaría todas las políticas RLS, y el aislamiento
// entre agencias sería ficticio: sin error, sin aviso, hasta que una agencia vea los datos
// de otra. Ver ADR-0003 y ADR-0007.

// =============================================================================
// PLATAFORMA — tablas globales, SIN tenantId y SIN RLS.
//
// Son las únicas excepciones permitidas a R1, y cada una está justificada aquí.
// Una tabla sin tenantId que no esté en esta sección es un defecto bloqueante.
// =============================================================================

/// La agencia cliente. Es la unidad de aislamiento: define qué es "un tenant".
/// Global por necesidad — es la tabla que da sentido a todas las demás.
model Tenant {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Identificador legible para URLs y soporte: "viajes-del-caribe"
  slug      String   @unique @db.VarChar(63)
  nombre    String   @db.VarChar(200)

  /// Mercado de operación. Decide moneda, impuestos y normativa por defecto.
  paisIso   String   @default("CO") @map("pais_iso") @db.Char(2)
  monedaIso String   @default("COP") @map("moneda_iso") @db.Char(3)
  zonaHoraria String @default("America/Bogota") @map("zona_horaria") @db.VarChar(64)

  estado    EstadoTenant @default(EN_PRUEBA)

  creadoEn     DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  usuarios       Usuario[]
  etapas         EtapaPipeline[]
  mayoristas     Mayorista[]
  paquetes       Paquete[]
  contactos      Contacto[]
  oportunidades  Oportunidad[]
  definicionesCampo DefinicionCampoPersonalizado[]
  cuentasWhatsapp   CuentaWhatsapp[]
  canales           Canal[]

  @@map("tenants")
}

enum EstadoTenant {
  EN_PRUEBA
  ACTIVO
  SUSPENDIDO
  CANCELADO

  @@map("estado_tenant")
}

/// Monedas habilitadas. Dato de referencia universal, igual para todos.
model Moneda {
  codigoIso String @id @map("codigo_iso") @db.Char(3)
  nombre    String @db.VarChar(80)
  /// Cuántos decimales tiene la moneda. COP = 0, USD = 2.
  /// Es lo que convierte `unidades` en un importe legible. Ver packages/domain/money.ts.
  decimales Int    @db.SmallInt

  @@map("monedas")
}

// -----------------------------------------------------------------------------
// Las cuatro tablas globales de ADR-0008. NINGUNA lleva `tenant_id`, y eso NO es
// cosmético: si alguna columna se llamara así, el aplicador dirigido por datos de
// `policies/001-aislamiento-tenant.sql` le pondría RLS automáticamente y volvería a
// ser ilegible sin contexto de tenant — que es justo el ciclo huevo-gallina que el
// ADR existe para romper, y se descubriría en producción sin ningún error. Por eso
// la columna del directorio se llama `tenant_resuelto_id`. Lo verifica la aserción 17.
//
// Ningún rol de login tiene un solo privilegio sobre ellas: se llegan por función
// `SECURITY DEFINER`. Están modeladas aquí para que Prisma no las vea como deriva y
// proponga borrarlas, no para que nadie las consulte desde el cliente: cualquier uso
// accidental desde la API falla con 42501, que es el fallo ruidoso que se quiere.
// -----------------------------------------------------------------------------

/// Declaración de qué tablas están fuera de RLS y con qué privilegios, por par
/// (tabla, rol). Es **dato de control**, no un catálogo inocuo: `001` y `002` aplican
/// literalmente lo que diga esta tabla, así que quien pudiera escribirla conseguiría
/// que el siguiente despliegue le concediera privilegios por sí solo. De ahí que se
/// declare a sí misma con privilegios vacíos y que la aserción 11 fije sus tripletas
/// contra un literal que vive en el repositorio. Ver ADR-0008 §1.2.
model ExcepcionRls {
  tabla       String   @db.Text
  rol         String   @db.Text
  /// Privilegios exactos que ese rol debe tener sobre esa tabla. `{}` = ninguno.
  privilegios String[] @db.Text
  motivo      String   @db.Text

  @@id([tabla, rol])
  @@map("excepciones_rls")
}

/// Directorio de enrutamiento: el mapa `identificador de Meta` → tenant.
///
/// La clave va en **HMAC-SHA256 con pimienta fuera de la base**, nunca en claro:
/// `phone_number_id` es numérico y de espacio pequeño, así que un hash simple se
/// invierte por fuerza bruta en minutos. Con la pimienta en el almacén de secretos,
/// un volcado de la base, de una réplica o de un respaldo no revela ni un solo
/// identificador. El tipo entra DENTRO del HMAC (`pn:` o `waba:`), lo que separa
/// dominios sin columna de tipo. Ver ADR-0008 §1.1.
model EnrutamientoCanal {
  claveCanalHmac   Bytes  @id @map("clave_canal_hmac")
  tenantResueltoId String @map("tenant_resuelto_id") @db.Uuid
  /// Nulo en las filas de tipo WABA: un evento de gestión apunta a la cuenta, no a un número.
  canalId          String? @map("canal_id") @db.Uuid

  /// Clave foránea **compuesta**: `(canal_id, tenant_resuelto_id)` contra
  /// `canales (id, tenant_id)`. Escrita simple apuntaría al canal de otro tenant sin
  /// que nada lo impidiera, y nadie lo notaría hasta que una fila cruzara agencias.
  /// Es el patrón de toda referencia cruzada entre tablas con tenant. Aserción 25.
  canal Canal? @relation(fields: [canalId, tenantResueltoId], references: [id, tenantId], onDelete: Restrict, onUpdate: Restrict)

  estado          EstadoEnrutamiento
  /// Con qué pimienta se calculó la clave. Es lo que permite saber, durante una
  /// rotación, qué filas están reconstruidas y cuáles no.
  pimientaVersion Int @map("pimienta_version") @db.SmallInt

  @@index([tenantResueltoId])
  @@map("enrutamiento_canales")
}

/// Historial del directorio: que un secuestro sea detectable y demostrable.
///
/// `registros_auditoria` no sirve para esto: tiene `tenant_id` y RLS forzada, así que
/// el registro del ataque quedaría archivado bajo el **atacante** y la víctima no
/// podría verlo jamás. Solo inserción: ningún rol tiene `UPDATE` ni `DELETE`, ni
/// siquiera el propietario (aserción 24). Su retención de 5 años se ejecuta soltando
/// particiones anuales — soltar una partición no es un `DELETE` sobre filas, así que
/// el plazo es aplicable sin conceder a nadie el privilegio que lo invalidaría todo.
///
/// Se indexa por `canal_id` y `cuenta_id`, **nunca por el HMAC**: el HMAC depende de un
/// secreto rotable, y tras la primera rotación la historia quedaría inconsultable para
/// siempre. Hacen falta los dos porque `canal_id` es nulo en las filas WABA.
model EnrutamientoHistorial {
  /// `gen_random_uuid()` y no uuid v7: lo genera el motor dentro de una función, y
  /// PostgreSQL 16 —la versión del entorno local— no trae `uuidv7()`. El orden temporal
  /// lo da `ocurrido_en`, que además es la clave de particionado.
  id              String  @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  canalId         String? @map("canal_id") @db.Uuid
  cuentaId        String? @map("cuenta_id") @db.Uuid
  /// Atributos informativos, no clave de búsqueda.
  claveCanalHmac  Bytes   @map("clave_canal_hmac")
  pimientaVersion Int     @map("pimienta_version") @db.SmallInt

  tenantAnterior String? @map("tenant_anterior") @db.Uuid
  tenantNuevo    String  @map("tenant_nuevo") @db.Uuid
  estadoAnterior EstadoEnrutamiento? @map("estado_anterior")
  estadoNuevo    EstadoEnrutamiento  @map("estado_nuevo")

  actorUsuarioId String? @map("actor_usuario_id") @db.Uuid
  actorTenantId  String? @map("actor_tenant_id") @db.Uuid
  motivo         String  @db.VarChar(200)
  ocurridoEn     DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(3)

  /// La clave primaria incluye la columna de particionado porque PostgreSQL lo exige.
  @@id([id, ocurridoEn])
  @@index([canalId, ocurridoEn(sort: Desc)])
  @@index([cuentaId, ocurridoEn(sort: Desc)])
  @@index([tenantNuevo, ocurridoEn(sort: Desc)])
  @@map("enrutamiento_historial")
}

/// Staging del webhook: el evento aterriza aquí **antes** del 200 a Meta.
///
/// El invariante: no se devuelve 200 antes de que el evento esté en una tabla durable.
/// Encolar a secas no lo cumple — Redis no es un almacén transaccional y una pérdida
/// ahí es un mensaje de cliente que ningún asesor verá jamás.
///
/// Es la única tabla con contenido de varios tenants sin RLS, así que el contenido va
/// cifrado desde el proceso de Node (nunca con `pgcrypto`, que dejaría la clave en
/// `pg_stat_statements`), con nonce y etiqueta por fila, AAD = `recepcion_id` y versión
/// de clave para poder rotar sin recifrar. Vive **minutos**: se anula al clasificar.
model RecepcionWebhook {
  /// `sha256` del cuerpo crudo del POST. Irreversible: no es dato personal.
  recepcionId    Bytes   @id @map("recepcion_id")
  payloadCifrado Bytes?  @map("payload_cifrado")
  /// 96 bits aleatorios por fila.
  payloadNonce   Bytes?  @map("payload_nonce")
  payloadTag     Bytes?  @map("payload_tag")
  claveVersion   Int     @map("clave_version") @db.SmallInt

  recibidoEn DateTime  @default(now()) @map("recibido_en") @db.Timestamptz(3)
  anuladoEn  DateTime? @map("anulado_en") @db.Timestamptz(3)

  changes RecepcionWebhookChange[]

  @@index([recibidoEn])
  @@map("recepciones_webhook")
}

/// El grano real del procesamiento es el `change`, no el POST.
///
/// Un POST puede traer varios `changes` de WABAs distintos. Con el estado de proceso en
/// la fila de la recepción, procesar el primero marcaba la recepción entera y anulaba el
/// payload: los mensajes de los otros dos tenants no existieron nunca, sin un solo error.
/// Por eso `procesado_en` vive aquí. Ver ADR-0008 §4 y RV-1 de la auditoría.
model RecepcionWebhookChange {
  recepcionId Bytes            @map("recepcion_id")
  recepcion   RecepcionWebhook @relation(fields: [recepcionId], references: [recepcionId], onDelete: Cascade)
  /// Orden aplanado sobre `entry[].changes[]`. Definido de una vez: dos convenciones
  /// distintas producirían identificadores de trabajo distintos para el mismo reintento.
  indice      Int              @db.SmallInt

  estado      EstadoChangeRecepcion @default(PENDIENTE)
  procesadoEn DateTime?             @map("procesado_en") @db.Timestamptz(3)

  @@id([recepcionId, indice])
  @@index([procesadoEn])
  @@map("recepciones_webhook_changes")
}

enum EstadoEnrutamiento {
  ACTIVO
  SUSPENDIDO
  REVOCADO

  @@map("estado_enrutamiento")
}

enum EstadoChangeRecepcion {
  PENDIENTE
  /// Procesado con éxito bajo su tenant.
  PROCESADO
  /// Clasificado sin procesar: tenant desconocido o revocado. El contenido se borró.
  CLASIFICADO

  @@map("estado_change_recepcion")
}

// =============================================================================
// IDENTIDAD
// =============================================================================

/// Usuario de una agencia.
///
/// Decisión: el usuario pertenece a UN tenant. Una persona que trabaje en dos agencias
/// tiene dos cuentas. La alternativa —usuario global con membresías— obliga a una tabla
/// global con datos personales y complica cada consulta, a cambio de resolver un caso
/// que en este mercado es raro. Si deja de serlo, se revisa con un ADR.
model Usuario {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  correo         String  @db.VarChar(255)
  nombre         String  @db.VarChar(200)
  hashContrasena String? @map("hash_contrasena") @db.VarChar(255)
  rol            RolUsuario @default(ASESOR)
  activo         Boolean @default(true)

  ultimoAccesoEn DateTime? @map("ultimo_acceso_en") @db.Timestamptz(3)
  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(3)

  oportunidadesAsignadas Oportunidad[] @relation("AsesorAsignado")

  /// El correo es único dentro de la agencia, no globalmente: ver la decisión de arriba.
  @@unique([tenantId, correo])
  @@index([tenantId, activo])
  @@map("usuarios")
}

enum RolUsuario {
  DUENO
  ADMINISTRADOR
  ASESOR
  SOLO_LECTURA

  @@map("rol_usuario")
}

// =============================================================================
// CONFIGURACIÓN POR TENANT — R12 en acción
// =============================================================================

/// Etapas del embudo. **Tabla, no enum.**
///
/// Cada agencia tiene su proceso de venta. Un enum en el código obligaría a una migración
/// con reasignación de filas el día que la primera agencia pida una etapa distinta —
/// y ese día llega siempre. Ver ADR-0006.
model EtapaPipeline {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre      String  @db.VarChar(80)
  orden       Int     @db.SmallInt
  /// Probabilidad de cierre asociada a la etapa, para proyectar ingresos.
  probabilidad Int    @default(0) @db.SmallInt
  /// Etapas terminales: la oportunidad sale del embudo.
  esGanada    Boolean @default(false) @map("es_ganada")
  esPerdida   Boolean @default(false) @map("es_perdida")

  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  oportunidades Oportunidad[]

  @@unique([tenantId, orden])
  @@index([tenantId])
  @@map("etapas_pipeline")
}

/// Definición de un campo personalizado.
///
/// Se diseña desde la PRIMERA migración aunque la interfaz llegue después: añadirlo más
/// tarde significa migrar datos de producción. Misma categoría que tenantId, el versionado
/// de cotizaciones y los time limits. Ver ADR-0006.
///
/// Las definiciones son relacionales (se consultan, validan y ordenan); los valores viven
/// en una columna jsonb de la propia entidad, con índice GIN. Así se evita la tabla genérica
/// clave-valor, que se degrada en cuanto hay volumen.
model DefinicionCampoPersonalizado {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  entidad     EntidadPersonalizable
  /// Clave dentro del jsonb. Estable: renombrarla rompe los datos ya guardados.
  clave       String  @db.VarChar(64)
  etiqueta    String  @db.VarChar(120)
  tipo        TipoCampoPersonalizado
  obligatorio Boolean @default(false)
  orden       Int     @default(0) @db.SmallInt
  /// Opciones para los tipos de selección.
  opciones    Json?   @db.JsonB

  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@unique([tenantId, entidad, clave])
  @@index([tenantId, entidad])
  @@map("definiciones_campo_personalizado")
}

enum EntidadPersonalizable {
  CONTACTO
  VIAJERO
  OPORTUNIDAD
  ARCHIVO_VIAJE

  @@map("entidad_personalizable")
}

enum TipoCampoPersonalizado {
  TEXTO
  NUMERO
  FECHA
  BOOLEANO
  SELECCION
  SELECCION_MULTIPLE

  @@map("tipo_campo_personalizado")
}

// =============================================================================
// CATÁLOGO — el corazón de la cabeza de playa
// =============================================================================

/// Quien arma el paquete y se lo vende a la agencia.
model Mayorista {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre          String  @db.VarChar(200)
  /// Identificador canónico global del proveedor.
  ///
  /// Hoy no se usa. Existe porque sin él, el "Hotel Las Américas" de una agencia y el de otra
  /// son entidades distintas para siempre, y la calificación compartida de proveedores
  /// —el horizonte de la red entre agencias— sería imposible sin reconciliar a mano.
  /// Cuesta una columna ahora; cuesta un proyecto después.
  proveedorCanonicoId String? @map("proveedor_canonico_id") @db.Uuid

  contactoNombre  String? @map("contacto_nombre") @db.VarChar(200)
  contactoCorreo  String? @map("contacto_correo") @db.VarChar(255)
  contactoTelefono String? @map("contacto_telefono") @db.VarChar(32)
  /// Días que da el mayorista para pagar antes de liberar el cupo. Valor por defecto
  /// del time limit cuando se crea una reserva con él.
  diasTimeLimit   Int?    @map("dias_time_limit") @db.SmallInt
  notas           String? @db.Text

  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  paquetes Paquete[]

  @@index([tenantId, eliminadoEn])
  @@index([tenantId, nombre])
  @@map("mayoristas")
}

/// Un paquete turístico: producto ya armado que la agencia revende.
model Paquete {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  mayoristaId String?    @map("mayorista_id") @db.Uuid
  mayorista   Mayorista? @relation(fields: [mayoristaId], references: [id], onDelete: SetNull)

  nombre       String  @db.VarChar(200)
  destino      String  @db.VarChar(120)
  paisIso      String? @map("pais_iso") @db.Char(2)
  /// Duración declarada. Se guardan ambas porque el sector habla de "7 días / 6 noches"
  /// y no siempre se deduce una de la otra (vuelos nocturnos, salidas de madrugada).
  dias         Int     @db.SmallInt
  noches       Int     @db.SmallInt

  planAlimentacion PlanAlimentacion @map("plan_alimentacion")
  /// Qué incluye, como lista de líneas legibles. No se modela cada servicio por separado:
  /// el paquete ya viene armado. Cuando llegue el armado a medida, serán QuoteItem.
  inclusiones  Json    @default("[]") @db.JsonB
  exclusiones  Json    @default("[]") @db.JsonB
  descripcion  String? @db.Text

  activo       Boolean @default(true)
  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  temporadas Temporada[]
  salidas    Salida[]

  @@index([tenantId, activo, eliminadoEn])
  @@index([tenantId, destino])
  @@map("paquetes")
}

enum PlanAlimentacion {
  TODO_INCLUIDO
  DESAYUNO
  MEDIA_PENSION
  PENSION_COMPLETA
  SIN_ALIMENTACION

  @@map("plan_alimentacion")
}

/// Rango de fechas con precio propio: temporada alta, baja, puente festivo.
///
/// En Colombia los puentes festivos son su propia temporada y pueden costar como la alta.
model Temporada {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  paqueteId String  @map("paquete_id") @db.Uuid
  paquete   Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)

  nombre String @db.VarChar(80)
  /// Fechas de viaje, sin hora: el 24 de diciembre es el 24 en cualquier huso. R9.
  desde  DateTime @db.Date
  hasta  DateTime @db.Date

  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  precios Precio[]

  @@index([tenantId, paqueteId])
  @@index([tenantId, desde, hasta])
  @@map("temporadas")
}

/// Precio de un paquete, por temporada, acomodación y tipo de pasajero.
///
/// **Aquí está la trampa del dominio.** El precio NO es "por pasajero": es *por persona en
/// acomodación X*, y baja cuanto más gente comparte la habitación. Cuatro personas en dos
/// dobles no cuestan lo mismo que cuatro en una cuádruple.
///
/// Un modelo con un solo precio por pasajero está mal y se descubre con el primer cliente.
/// Ver packages/domain/ocupacion.ts y docs/01-producto/02-lenguaje-ubicuo.md.
model Precio {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  temporadaId String    @map("temporada_id") @db.Uuid
  temporada   Temporada @relation(fields: [temporadaId], references: [id], onDelete: Cascade)

  acomodacion   Acomodacion
  tipoPasajero  TipoPasajero @map("tipo_pasajero")

  /// Dinero en la unidad mínima de la moneda. R8. Ver packages/domain/money.ts.
  /// La tarifa neta es lo que cobra el mayorista: NUNCA se muestra al cliente.
  netoUnidades  BigInt @map("neto_unidades")
  /// La venta sugerida. El markup efectivo es venta - neto, y puede ajustarse por cotización.
  ventaUnidades BigInt @map("venta_unidades")
  monedaIso     String @map("moneda_iso") @db.Char(3)

  /// Edad de corte para este tipo de pasajero. "Niño de 2 a 11 años" es condición comercial
  /// real del tarifario y cambia entre mayoristas.
  edadMinima Int? @map("edad_minima") @db.SmallInt
  edadMaxima Int? @map("edad_maxima") @db.SmallInt

  creadoEn      DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @updatedAt @map("actualizado_en") @db.Timestamptz(3)

  @@unique([tenantId, temporadaId, acomodacion, tipoPasajero, edadMinima, edadMaxima])
  @@index([tenantId, temporadaId])
  @@map("precios")
}

enum Acomodacion {
  SENCILLA
  DOBLE
  TRIPLE
  CUADRUPLE

  @@map("acomodacion")
}

enum TipoPasajero {
  ADT
  CHD
  INF

  @@map("tipo_pasajero")
}

/// Fecha concreta en que opera un paquete, con su cupo.
model Salida {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid

  paqueteId String  @map("paquete_id") @db.Uuid
  paquete   Paquete @relation(fields: [paqueteId], references: [id], onDelete: Cascade)

  fecha        DateTime @db.Date
  /// Plazas que el mayorista tiene bloqueadas. Nulo = sin límite declarado.
  cupoTotal    Int?     @map("cupo_total") @db.SmallInt
  cupoVendido  Int      @default(0) @map("cupo_vendido") @db.SmallInt
  activa       Boolean  @default(true)

  creadoEn DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)

  @@unique([tenantId, paqueteId, fecha])
  @@index([tenantId, fecha, activa])
  @@map("salidas")
}

// =============================================================================
// CANALES — la verdad sobre la conexión de WhatsApp de cada agencia
//
// Estas dos tablas SÍ son de negocio: llevan tenant_id y RLS como todas. Aquí viven
// los identificadores de Meta **en claro** y los tokens cifrados de terceros, bajo
// aislamiento. El directorio global de ADR-0008 es una proyección DERIVADA de esto:
// si se pierde la pimienta, el directorio se reconstruye recorriendo estas tablas.
// =============================================================================

/// Cuenta de WhatsApp Business (WABA) que la agencia conecta por Embedded Signup.
///
/// Existe como entidad propia, y no como una columna de `Canal`, por dos razones del
/// ADR-0008: el token de negocio que devuelve el canje se emite **sobre el WABA**, no
/// sobre un número; y los webhooks de plantillas y de cuenta **no traen
/// `phone_number_id`**, solo el WABA en `entry[].id`, de modo que el historial del
/// directorio necesita una referencia propia y estable a la cuenta (`cuenta_id`) para
/// no quedar huérfano justo en las filas que gobiernan los eventos de gestión.
model CuentaWhatsapp {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// Identificador de Meta, en claro y bajo RLS. **Atributo reasignable, no clave**:
  /// Meta no garantiza su inmutabilidad y un número migrado entre WABAs cambia de cuenta.
  wabaId String  @map("waba_id") @db.VarChar(32)
  nombre String? @db.VarChar(200)
  estado EstadoCanal @default(ACTIVO)

  /// Token de negocio cifrado con AES-256-GCM desde el proceso (R6). Nunca en claro,
  /// nunca con la clave viajando dentro del SQL.
  tokenCifrado Bytes? @map("token_cifrado")
  tokenNonce   Bytes? @map("token_nonce")
  tokenTag     Bytes? @map("token_tag")
  claveVersion Int?   @map("clave_version") @db.SmallInt

  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  /// Cronología del canal: vive aquí, bajo RLS, y no en el directorio global, donde
  /// las fechas eran el libro de clientes servido a quien pudiera leerlo.
  revocadoEn     DateTime? @map("revocado_en") @db.Timestamptz(3)
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(3)
  creadoPor      String?   @map("creado_por") @db.Uuid
  actualizadoPor String?   @map("actualizado_por") @db.Uuid

  canales Canal[]

  /// Sostiene la clave foránea compuesta de `canales`. Sin esta unicidad, PostgreSQL
  /// no admite `(cuenta_id, tenant_id) REFERENCES cuentas_whatsapp (id, tenant_id)`.
  @@unique([id, tenantId])
  @@unique([tenantId, wabaId])
  @@index([tenantId, estado])
  @@map("cuentas_whatsapp")
}

/// Un número de WhatsApp conectado. Es el `Canal` del lenguaje ubicuo.
///
/// El `phone_number_id` **no** es la clave primaria, y eso importa: un número borrado y
/// vuelto a añadir no conserva el suyo. El canal es una entidad nuestra con UUID propio;
/// los identificadores de Meta son atributos reasignables. Tratarlos como clave habría
/// convertido la migración de número de un cliente en una cirugía de claves foráneas.
model Canal {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  cuentaId String         @map("cuenta_id") @db.Uuid
  /// Clave foránea compuesta: un canal no puede colgar de la cuenta de otro tenant.
  cuenta   CuentaWhatsapp @relation(fields: [cuentaId, tenantId], references: [id, tenantId], onDelete: Cascade)

  tipo          TipoCanal @default(WHATSAPP)
  phoneNumberId String    @map("phone_number_id") @db.VarChar(32)
  /// El número tal como lo marca un cliente, en E.164.
  numeroE164    String    @map("numero_e164") @db.VarChar(20)
  nombreVisible String?   @map("nombre_visible") @db.VarChar(200)
  estado        EstadoCanal @default(ACTIVO)

  creadoEn       DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn  DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  revocadoEn     DateTime? @map("revocado_en") @db.Timestamptz(3)
  eliminadoEn    DateTime? @map("eliminado_en") @db.Timestamptz(3)
  creadoPor      String?   @map("creado_por") @db.Uuid
  actualizadoPor String?   @map("actualizado_por") @db.Uuid

  enrutamientos EnrutamientoCanal[]

  /// Sostiene la clave foránea compuesta del directorio global.
  @@unique([id, tenantId])
  /// La unicidad del identificador de Meta es POR TENANT. Global sería un oráculo:
  /// el alta de una agencia fallaría y le confirmaría que ese número ya está en la
  /// plataforma. Que un mismo identificador no pueda estar activo en dos tenants lo
  /// impone el directorio, cuya clave primaria es global.
  @@unique([tenantId, phoneNumberId])
  @@index([tenantId, estado])
  @@index([tenantId, cuentaId])
  @@map("canales")
}

enum TipoCanal {
  WHATSAPP

  @@map("tipo_canal")
}

enum EstadoCanal {
  ACTIVO
  /// Impago o investigación: se persiste lo que llegue, no se emite en vivo.
  SUSPENDIDO
  /// Agencia dada de baja. La fila no se borra: borrarla convierte a un excliente
  /// conocido en un desconocido y borra la evidencia de cuándo dejamos de tratar sus datos.
  REVOCADO

  @@map("estado_canal")
}

// =============================================================================
// CRM
// =============================================================================

/// Persona con la que la agencia conversa. Puede o no viajar.
///
/// `Contacto` ≠ `Viajero`: quien paga no siempre viaja. Fusionarlos parece una simplificación
/// razonable hasta el primer viaje familiar, y entonces hay que rehacer el modelo con datos
/// en producción. Ver docs/01-producto/02-lenguaje-ubicuo.md.
model Contacto {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  /// En formato E.164 (+573001234567). Es la llave natural del canal de WhatsApp.
  telefonoE164 String  @map("telefono_e164") @db.VarChar(20)
  nombre       String? @db.VarChar(200)
  correo       String? @db.VarChar(255)

  /// Consentimiento para contactar. Obligatorio y auditable: Ley 1581 de 2012 y políticas
  /// de Meta. Sin esto no se puede iniciar conversación.
  consentimientoEn     DateTime? @map("consentimiento_en") @db.Timestamptz(3)
  consentimientoCanal  String?   @map("consentimiento_canal") @db.VarChar(40)
  consentimientoRevocadoEn DateTime? @map("consentimiento_revocado_en") @db.Timestamptz(3)

  /// Valores de los campos personalizados. Las definiciones están en
  /// DefinicionCampoPersonalizado; aquí van los datos, con índice GIN.
  camposPersonalizados Json @default("{}") @map("campos_personalizados") @db.JsonB

  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  oportunidades Oportunidad[]

  /// Dos agencias distintas pueden tener el mismo teléfono de cliente: la unicidad
  /// es POR TENANT, nunca global.
  @@unique([tenantId, telefonoE164])
  @@index([tenantId, eliminadoEn])
  @@map("contactos")
}

/// Una intención de compra en el embudo.
model Oportunidad {
  id       String @id @default(uuid(7)) @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contactoId String   @map("contacto_id") @db.Uuid
  contacto   Contacto @relation(fields: [contactoId], references: [id], onDelete: Cascade)

  etapaId String        @map("etapa_id") @db.Uuid
  etapa   EtapaPipeline @relation(fields: [etapaId], references: [id])

  asesorId String?  @map("asesor_id") @db.Uuid
  asesor   Usuario? @relation("AsesorAsignado", fields: [asesorId], references: [id], onDelete: SetNull)

  titulo  String  @db.VarChar(200)
  destino String? @db.VarChar(120)

  /// Intención de viaje extraída de la conversación: fechas aproximadas y composición.
  /// Nulas al principio: el asesor (o la IA, más adelante) las completa.
  fechaViajeDesde DateTime? @map("fecha_viaje_desde") @db.Date
  fechaViajeHasta DateTime? @map("fecha_viaje_hasta") @db.Date
  adultos         Int?      @db.SmallInt
  ninos           Int?      @db.SmallInt
  infantes        Int?      @db.SmallInt

  /// Valor estimado, en la unidad mínima de la moneda. R8.
  valorEstimadoUnidades BigInt? @map("valor_estimado_unidades")
  monedaIso             String? @map("moneda_iso") @db.Char(3)

  /// Obligatorio al marcar perdida. Sin motivo no hay aprendizaje.
  motivoPerdida String? @map("motivo_perdida") @db.VarChar(200)

  camposPersonalizados Json @default("{}") @map("campos_personalizados") @db.JsonB

  creadoEn      DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime  @updatedAt @map("actualizado_en") @db.Timestamptz(3)
  cerradaEn     DateTime? @map("cerrada_en") @db.Timestamptz(3)
  eliminadoEn   DateTime? @map("eliminado_en") @db.Timestamptz(3)

  @@index([tenantId, etapaId, actualizadoEn(sort: Desc)])
  @@index([tenantId, asesorId])
  @@index([tenantId, contactoId])
  @@map("oportunidades")
}

// =============================================================================
// AUDITORÍA
// =============================================================================

/// Bitácora de acciones. Solo escritura: nadie modifica ni borra un registro de auditoría.
model RegistroAuditoria {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid

  usuarioId String? @map("usuario_id") @db.Uuid
  accion    String  @db.VarChar(80)
  entidad   String  @db.VarChar(80)
  entidadId String? @map("entidad_id") @db.Uuid
  /// Qué cambió. Nunca contenido de mensajes ni números de documento: R10.
  detalle   Json?   @db.JsonB
  ip        String? @db.Inet

  ocurridoEn DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(3)

  @@index([tenantId, ocurridoEn(sort: Desc)])
  @@index([tenantId, entidad, entidadId])
  @@map("registros_auditoria")
}

// =============================================================================
// EVENTOS — patrón outbox
// =============================================================================

/// Eventos de dominio pendientes de publicar.
///
/// Se escriben en la MISMA transacción que el cambio de estado; un relay los envía a BullMQ.
/// Sin esto: publicas el evento, la transacción revierte, y acabas de notificar un hecho que
/// nunca ocurrió.
model Outbox {
  id       BigInt @id @default(autoincrement())
  tenantId String @map("tenant_id") @db.Uuid

  agregado     String @db.VarChar(80)
  agregadoId   String @map("agregado_id") @db.Uuid
  tipoEvento   String @map("tipo_evento") @db.VarChar(120)
  /// Los eventos son contrato público: cambiar su forma rompe a los consumidores,
  /// igual que cambiar una API. Por eso la versión existe desde el primer día.
  versionEvento Int   @default(1) @map("version_evento") @db.SmallInt
  payload      Json   @db.JsonB

  ocurridoEn   DateTime  @default(now()) @map("ocurrido_en") @db.Timestamptz(3)
  publicadoEn  DateTime? @map("publicado_en") @db.Timestamptz(3)
  intentos     Int       @default(0) @db.SmallInt

  /// Índice parcial: el relay solo busca lo no publicado, que es una fracción diminuta
  /// de la tabla. Sin `where`, el índice crecería con todo el histórico.
  @@index([ocurridoEn], map: "idx_outbox_pendientes")
  @@index([tenantId, agregado, agregadoId])
  @@map("outbox")
}
