{
  "name": "@viajapro/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "worker": "dotenv -e ../../.env -- tsx src/worker.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "lint": "eslint src",
    "campos:sembrar-dev": "dotenv -e ../../.env -- tsx src/shared/cifrado/sembrar-campos-dev.ts",
    "identidad:sembrar-dev": "dotenv -e ../../.env -- tsx src/modules/identity/scripts/sembrar-credenciales-dev.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@prisma/client": "^5.22.0",
    "@viajapro/contracts": "workspace:*",
    "@viajapro/domain": "workspace:*",
    "better-auth": "^1.7.11",
    "bullmq": "^6.3.17",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.1.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "dotenv-cli": "^7.4.4",
    "pg": "^8.13.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
