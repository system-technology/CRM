{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalDependencies": [".env.example", "tsconfig.base.json"],
  "globalEnv": ["NODE_ENV", "APP_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "DATABASE_URL",
        "DATABASE_APP_URL",
        "DATABASE_ALTAS_URL",
        "DATABASE_WEBHOOK_URL",
        "DATABASE_IDENTIDAD_URL",
        "BETTER_AUTH_SECRET",
        "WHATSAPP_DIRECTORY_PEPPER",
        "WEBHOOK_PAYLOAD_KEY",
        "WEBHOOK_PAYLOAD_KEY_VERSION",
        "META_APP_SECRET",
        "WHATSAPP_WEBHOOK_VERIFY_TOKEN",
        "REDIS_URL"
      ],
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "@viajapro/web#typecheck": {
      "dependsOn": ["^build", "@viajapro/web#build"]
    },
    "@viajapro/database#typecheck": {
      "dependsOn": ["^build", "@viajapro/database#build"]
    }
  },
  "agentGuidance": false
}
