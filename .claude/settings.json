{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(//d/Projects/CRM/**)",
      "Glob(//d/Projects/CRM/**)",
      "Grep(//d/Projects/CRM/**)",
      "Bash(pnpm install)",
      "Bash(pnpm run:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm db:generate:*)",
      "Bash(pnpm db:migrate:*)",
      "Bash(pnpm db:seed:*)",
      "Bash(pnpm format:*)",
      "Bash(npx prettier:*)",
      "Bash(npx tsc:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(docker compose -f infra/docker/docker-compose.yml ps:*)",
      "Bash(docker compose -f infra/docker/docker-compose.yml logs:*)",
      "WebFetch(domain:developers.facebook.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:www.prisma.io)",
      "WebFetch(domain:docs.nestjs.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:www.postgresql.org)",
      "Bash(git commit:*)",
      "Bash(git checkout -b:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git tag:*)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(pnpm add:*)",
      "Bash(node .claude/hooks/autorizar-integracion.mjs:*)",
      "Bash(git fetch:*)",
      "Bash(git worktree:*)",
      "Bash(git stash:*)",
      "Bash(git ls-remote:*)",
      "Bash(git rev-parse:*)",
      "Bash(git merge-base:*)",
      "Bash(git check-ignore:*)",
      "Bash(git clean -xdf:*)",
      "Bash(git mv:*)",
      "Bash(git restore:*)",
      "Bash(corepack pnpm lint:*)",
      "Bash(corepack pnpm typecheck:*)",
      "Bash(corepack pnpm test:*)",
      "Bash(corepack pnpm build:*)",
      "Bash(corepack pnpm format:*)",
      "Bash(corepack pnpm install:*)",
      "Bash(corepack pnpm db:*)",
      "Bash(corepack pnpm --filter:*)",
      "Bash(corepack pnpm exec:*)",
      "Bash(corepack pnpm add:*)",
      "Bash(corepack pnpm dev:*)",
      "Bash(node .claude/hooks/lib/politica-rama.test.mjs)",
      "Bash(node .claude/hooks/lib/guard-secretos.test.mjs)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/:*)",
      "Bash(gh run watch:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr list:*)",
      "Bash(taskkill:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)"
    ],
    "ask": ["Bash(docker compose:*)", "Bash(terraform:*)", "Bash(npm install:*)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git filter-branch:*)",
      "Bash(pnpm db:reset:*)",
      "Bash(psql:*)",
      "Bash(curl:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/session-start.mjs"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-secretos.mjs"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/guard-rama.mjs"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/post-edit.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/recordatorio-estado.mjs"
          }
        ]
      }
    ]
  },
  "env": {
    "APP_ENV": "local"
  },
  "includeCoAuthoredBy": true
}
